          "value" : "create_batch_call"
        },
        {
          "name" : "Get batch call",
          "value" : "get_batch_call"
        },
        {
          "name" : "Get conversation",
          "value" : "get_conversation_history_route"
        },
        {
          "name" : "Transcribe audio",
          "value" : "speech_to_text"
        },
        {
          "name" : "Get transcript",
          "value" : "get_transcript_by_id"
        }
      ]
    },
    {
      "id" : "baseUrl",
