      "choices" : [
        {
          "name" : "Global",
          "value" : "https://api.elevenlabs.io"
        },
        {
          "name" : "EU data residency",
          "value" : "https://api.eu.residency.elevenlabs.io"
        },
        {
          "name" : "India data residency",
          "value" : "https://api.in.residency.elevenlabs.io"
        }
      ]
    },
    {
