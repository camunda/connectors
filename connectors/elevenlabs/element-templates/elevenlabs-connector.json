      "label" : "Authentication credential",
      "optional" : true,
      "group" : "authentication",
      "binding" : {
        "name" : "serviceAuthenticationConfiguration",
        "type" : "zeebe:input"
      },
      "tooltip" : "Choose a reusable ElevenLabs credential, or configure the one-time API key below.",
      "type" : "Configuration",
      "configurationTemplate" : "io.camunda.connectors:elevenlabs-authentication:1"
