      "binding" : {
        "name" : "collection_id",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "get_user_voices_v2",
        "type" : "simple"
      },
      "tooltip" : "Collection ID to filter voices by.",
      "type" : "String"
    },
    {
      "id" : "get_user_voices_v2_query_gender",
      "label" : "Gender",
