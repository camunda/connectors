    },
    {
      "id" : "get_user_voices_v2_query_accent",
      "label" : "Accent",
      "optional" : true,
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "accent",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "get_user_voices_v2",
