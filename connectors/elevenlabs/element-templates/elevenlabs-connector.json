        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "apiKey.xi-api-key",
      "value" : "apiKey",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.type",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
        "isEmpty" : true,
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "authentication.apiKeyLocation.xi-api-key",
      "value" : "headers",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.apiKeyLocation",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
        "isEmpty" : true,
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "authentication.name.xi-api-key",
      "label" : "API key name",
      "optional" : false,
      "value" : "xi-api-key",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.name",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
        "isEmpty" : true,
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "authentication.value.xi-api-key",
      "label" : "API key",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.value",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
        "isEmpty" : true,
        "type" : "simple"
      },
      "tooltip" : "ElevenLabs API key, sent in the xi-api-key header. Create one in the <a href='https://elevenlabs.io/app/settings/api-keys' target='_blank'>ElevenLabs dashboard</a>.",
      "type" : "String",
      "secret" : true
    },
    {
      "id" : "text_to_speech_full_path_voice_id",
      "label" : "Voice ID",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "voice_id",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "tooltip" : "Voice ID to be used, you can use https://api.elevenlabs.io/v1/voices to list all the available voices.",
      "placeholder" : "21m00Tcm4TlvDq8ikWAM",
      "type" : "String"
    },
    {
      "id" : "text_to_speech_full_query_enable_logging",
      "label" : "Enable logging",
      "optional" : true,
      "group" : "parameters",
      "binding" : {
        "name" : "enable_logging",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "tooltip" : "When enable_logging is set to false zero retention mode will be used for the request. This will mean history features are unavailable for this request, including request stitching. Zero retention mode may only be used by enterprise customers.",
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "true",
          "value" : "true"
        },
        {
          "name" : "false",
          "value" : "false"
        }
      ]
    },
    {
      "id" : "text_to_speech_full_query_optimize_streaming_latency",
      "label" : "Optimize streaming latency",
      "optional" : true,
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "optimize_streaming_latency",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "tooltip" : "You can turn on latency optimizations at some cost of quality. The best possible final latency varies by model. Possible values:\n0 - default mode (no latency optimizations)\n1 - normal latency optimizations (about 50% of possible latency improvement of option 3)\n2 - strong latency optimizations (about 75% of possible latency improvement of option 3)\n3 - max latency optimizations\n4 - max latency optimizations, but also with text normalizer turned off for even more latency savings (best latency, but can mispronounce eg numbers and dates).\n\nDefaults to None.\n",
      "type" : "String"
    },
    {
      "id" : "text_to_speech_full_query_output_format",
      "label" : "Output format",
      "optional" : true,
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "output_format",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "tooltip" : "Output format of the generated audio. Formatted as codec_sample_rate_bitrate. So an mp3 with 22.05kHz sample rate at 32kbs is represented as mp3_22050_32. MP3 with 192kbps bitrate requires you to be subscribed to Creator tier or above. PCM and WAV formats with 44.1kHz sample rate requires you to be subscribed to Pro tier or above. Note that the μ-law format (sometimes written mu-law, often approximated as u-law) is commonly used for Twilio audio inputs.",
      "placeholder" : "mp3_44100_128",
      "type" : "String"
    },
    {
      "id" : "text_to_speech_full_$path",
      "value" : "=\"/v1/text-to-speech/\"+voice_id",
      "group" : "parameters",
      "binding" : {
        "name" : "operationPath",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "text_to_speech_full_$headers",
      "value" : "={}",
      "group" : "parameters",
      "binding" : {
        "name" : "headers",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "text_to_speech_full_$queryParameters",
      "value" : "=context(get entries({output_format: output_format, enable_logging: enable_logging, optimize_streaming_latency: optimize_streaming_latency})[value != null])",
      "group" : "parameters",
      "binding" : {
        "name" : "queryParameters",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "text_to_speech_full_$method",
      "value" : "POST",
      "group" : "parameters",
      "binding" : {
        "name" : "method",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "text_to_speech_full",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
