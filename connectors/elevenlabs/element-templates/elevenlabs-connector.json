    {
      "id" : "authType",
      "value" : "apiKey.xi-api-key",
      "group" : "authentication",
      "binding" : {
        "name" : "authType",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
