{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "Hybrid Send Message Connector (Send Task)",
  "id" : "io.camunda.connectors.message.sendtask.v1-hybrid",
  "keywords" : [ "send message", "correlate message", "publish message", "message event", "trigger process", "signal process" ],
  "version" : 1,
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [ "bpmn:Task" ],
  "elementType" : {
    "value" : "bpmn:SendTask"
  },
  "engines" : {
    "camunda" : "^8.3"
  },
  "groups" : [ {
    "id" : "taskDefinitionType",
    "label" : "Task definition type"
  }, {
    "id" : "operation",
    "label" : "Operation"
  }, {
    "id" : "connector",
    "label" : "Connector"
  }, {
    "id" : "output",
    "label" : "Output mapping"
  }, {
    "id" : "error",
    "label" : "Error handling"
  }, {
    "id" : "retries",
    "label" : "Retries"
  } ],
  "properties" : [ {
    "binding" : {
      "property" : "type",
      "type" : "zeebe:taskDefinition"
    },
    "group" : "taskDefinitionType",
    "id" : "taskDefinitionType",
    "type" : "String",
    "value" : "io.camunda:sendMessage:1"
  }, {
    "binding" : {
      "name" : "messageName",
      "type" : "zeebe:input"
    },
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "id" : "messageName",
    "label" : "Message name",
    "type" : "String"
  }, {
    "binding" : {
      "name" : "correlationKey",
      "type" : "zeebe:input"
    },
    "feel" : "optional",
    "id" : "correlationKey",
    "label" : "Correlation key",
    "optional" : true,
    "type" : "String"
  }, {
    "binding" : {
      "name" : "variables",
      "type" : "zeebe:input"
    },
    "feel" : "optional",
    "id" : "variables",
    "label" : "Payload",
    "optional" : true,
    "type" : "String"
  }, {
    "binding" : {
      "name" : "tenantId",
      "type" : "zeebe:input"
    },
    "feel" : "optional",
    "id" : "tenantId",
    "label" : "Tenant id",
    "optional" : true,
    "type" : "String"
  }, {
    "binding" : {
      "name" : "requestTimeout",
      "type" : "zeebe:input"
    },
    "feel" : "optional",
    "id" : "requestTimeout",
    "label" : "Request timeout",
    "optional" : true,
    "type" : "String"
  }, {
    "binding" : {
      "name" : "correlationType.type",
      "type" : "zeebe:input"
    },
    "choices" : [ {
      "name" : "Correlate message (with result)",
      "value" : "correlate"
    }, {
      "name" : "Publish message (with buffer)",
      "value" : "publish"
    } ],
    "description" : "Send message with <a href='https://docs.camunda.io/docs/components/concepts/messages/#message-buffering' target='_blank'>buffer (publish)</a> or with <a href='https://docs.camunda.io/docs/components/concepts/messages/#message-response' target='_blank'>result (correlate)</a>",
    "group" : "operation",
    "id" : "correlationType.type",
    "label" : "Correlation mode",
    "type" : "Dropdown",
    "value" : "publish"
  }, {
    "binding" : {
      "name" : "correlationType.timeToLive",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "correlationType.type",
      "equals" : "publish",
      "type" : "simple"
    },
    "feel" : "optional",
    "group" : "operation",
    "id" : "correlationType.timeToLive",
    "label" : "Time to live (as ISO 8601)",
    "optional" : true,
    "tooltip" : "Duration for which the message remains buffered",
    "type" : "String"
  }, {
    "binding" : {
      "name" : "correlationType.messageId",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "correlationType.type",
      "equals" : "publish",
      "type" : "simple"
    },
    "feel" : "optional",
    "group" : "operation",
    "id" : "correlationType.messageId",
    "label" : "Message id (optional)",
    "optional" : true,
    "type" : "String"
  }, {
    "binding" : {
      "key" : "elementTemplateVersion",
      "type" : "zeebe:taskHeader"
    },
    "description" : "Version of the element template",
    "group" : "connector",
    "id" : "version",
    "label" : "Version",
    "type" : "Hidden",
    "value" : "1"
  }, {
    "binding" : {
      "key" : "elementTemplateId",
      "type" : "zeebe:taskHeader"
    },
    "description" : "ID of the element template",
    "group" : "connector",
    "id" : "id",
    "label" : "ID",
    "type" : "Hidden",
    "value" : "io.camunda.connectors.message.v1"
  }, {
    "binding" : {
      "key" : "resultVariable",
      "type" : "zeebe:taskHeader"
    },
    "description" : "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
    "group" : "output",
    "id" : "resultVariable",
    "label" : "Result variable",
    "type" : "String"
  }, {
    "binding" : {
      "key" : "resultExpression",
      "type" : "zeebe:taskHeader"
    },
    "description" : "Expression to map the response into process variables. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-expression\" target=\"_blank\">documentation</a>.",
    "feel" : "required",
    "group" : "output",
    "id" : "resultExpression",
    "label" : "Result expression",
    "type" : "Text"
  }, {
    "binding" : {
      "key" : "errorExpression",
      "type" : "zeebe:taskHeader"
    },
    "description" : "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
    "feel" : "required",
    "group" : "error",
    "id" : "errorExpression",
    "label" : "Error expression",
    "type" : "Text"
  }, {
    "binding" : {
      "property" : "retries",
      "type" : "zeebe:taskDefinition"
    },
    "description" : "Number of retries",
    "feel" : "optional",
    "group" : "retries",
    "id" : "retryCount",
    "label" : "Retries",
    "type" : "String",
    "value" : "3"
  }, {
    "binding" : {
      "key" : "retryBackoff",
      "type" : "zeebe:taskHeader"
    },
    "description" : "ISO-8601 duration to wait between retries",
    "group" : "retries",
    "id" : "retryBackoff",
    "label" : "Retry backoff",
    "type" : "String",
    "value" : "PT30S"
  }, {
    "binding" : {
      "key" : "jobTimeout",
      "type" : "zeebe:taskHeader"
    },
    "description" : "ISO-8601 duration after which Zeebe considers this job timed out if not yet completed. Leave empty to use the default timeout",
    "group" : "retries",
    "id" : "jobTimeout",
    "label" : "Job timeout",
    "optional" : true,
    "type" : "String"
  } ],
  "steps" : [ {
    "name" : "Correlate message (with result)",
    "description" : "Correlate a message to a running process instance in Camunda and receive the result",
    "keywords" : [ "correlate message", "message correlation", "receive result", "await response", "synchronous message" ],
    "presetId" : "type_correlate"
  }, {
    "name" : "Publish message (with buffer)",
    "description" : "Publish a message to Camunda with buffering support",
    "keywords" : [ "publish message", "buffer message", "send message", "emit event", "broadcast message", "trigger message" ],
    "presetId" : "type_publish"
  } ],
  "presets" : [ {
    "id" : "type_correlate",
    "properties" : {
      "correlationType.type" : "correlate"
    }
  }, {
    "id" : "type_publish",
    "properties" : {
      "correlationType.type" : "publish"
    }
  } ],
  "icon" : {
    "contents" : "data:image/svg+xml;base64,"
  }
}