    "feel" : "optional",
    "group" : "connection",
    "id" : "connection.username",
    "label" : "Username",
    "optional" : true,
    "type" : "String"
  }, {
    "binding" : {
      "name" : "connection.password",
      "type" : "zeebe:input"
