<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- connector-parent rather than connectors-parent: the latter adds runtime dependencies to every
       connector, and this artifact must not bring any dependencies to its consumers (Hub). -->
  <parent>
    <groupId>io.camunda.connector</groupId>
    <artifactId>connector-parent</artifactId>
    <version>8.11.0-alpha1</version>
    <relativePath>../../../parent/pom.xml</relativePath>
  </parent>

  <artifactId>connector-idp-element-templates</artifactId>
  <name>connector-idp-element-templates</name>
  <description>Element templates of the Camunda IDP extraction connectors, including all versioned
    snapshots, as classpath resources under META-INF/camunda/element-templates/idp/</description>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <license.inlineheader>Copyright Camunda Services GmbH and/or licensed to Camunda Services GmbH
under one or more contributor license agreements. Licensed under a proprietary license.
See the License.txt file for more information. You may not use this file
except in compliance with the proprietary license.</license.inlineheader>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- The committed templates are the source; CI already checks them against the Java
         annotations, so this module only copies them. hybrid/ is left out on purpose. -->
    <resources>
      <resource>
        <directory>${project.basedir}/../element-templates</directory>
        <targetPath>META-INF/camunda/element-templates/idp</targetPath>
        <includes>
          <include>*.json</include>
          <include>versioned/*.json</include>
        </includes>
      </resource>
    </resources>
  </build>
</project>
