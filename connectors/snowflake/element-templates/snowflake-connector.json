{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "Snowflake Outbound Connector",
  "id" : "io.camunda.connectors.Snowflake.v1",
  "description" : "Run SQL statements on Snowflake",
  "keywords" : [
    "Snowflake",
    "SQL",
    "query",
    "data warehouse",
    "statement",
    "database",
    "table"
  ],
  "documentationRef" : "https://docs.camunda.io/docs/8.11/components/connectors/out-of-the-box-connectors/snowflake/",
  "version" : 1,
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [
    "bpmn:Task"
  ],
  "elementType" : {
    "value" : "bpmn:ServiceTask"
  },
  "engines" : {
    "camunda" : "^8.11"
  },
  "groups" : [
    {
      "id" : "operation",
      "label" : "Operation"
    },
    {
      "id" : "authentication",
      "label" : "Authentication"
    },
    {
      "id" : "parameters",
      "label" : "Parameters"
    },
    {
      "id" : "requestBody",
      "label" : "Request body"
    },
    {
      "id" : "url",
      "label" : "URL"
    },
    {
      "id" : "timeout",
      "label" : "Timeout"
    },
    {
      "id" : "output",
      "label" : "Output mapping"
    },
    {
      "id" : "error",
      "label" : "Error handling"
    },
    {
      "id" : "retries",
      "label" : "Retries"
    }
  ],
  "properties" : [
    {
      "id" : "operationId",
      "label" : "Operation",
      "value" : "SubmitStatement",
      "group" : "operation",
      "binding" : {
        "name" : "operationId",
        "type" : "zeebe:input"
      },
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "Run SQL statement",
          "value" : "SubmitStatement"
        },
        {
          "name" : "Get statement status",
          "value" : "GetStatementStatus"
        },
        {
          "name" : "Cancel statement",
          "value" : "CancelStatement"
        }
      ]
    },
    {
      "id" : "baseUrl",
      "label" : "Account URL",
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^(=.*|https://[^/?#\\s]+)$",
          "message" : "Enter an https:// URL without a path, query or trailing slash."
        }
      },
      "feel" : "optional",
      "group" : "authentication",
      "binding" : {
        "name" : "baseUrl",
        "type" : "zeebe:input"
      },
      "tooltip" : "Your Snowflake account URL, <code>https://&lt;orgname&gt;-&lt;account_name&gt;.snowflakecomputing.com</code>, without a path. Find it in Snowsight under <b>Account details</b>.",
      "placeholder" : "https://myorg-myaccount.snowflakecomputing.com",
      "type" : "String"
    },
    {
      "id" : "serviceAuthenticationConfiguration",
      "label" : "Authentication credential",
      "optional" : true,
      "group" : "authentication",
      "binding" : {
        "name" : "serviceAuthenticationConfiguration",
        "type" : "zeebe:input"
      },
      "tooltip" : "Choose a reusable Snowflake credential, or configure the one-time access token below.",
      "type" : "Configuration",
      "configurationTemplate" : "io.camunda.connectors:snowflake-authentication:1"
    },
    {
      "id" : "authType",
      "value" : "bearer",
      "group" : "authentication",
      "binding" : {
        "name" : "authType",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
        "isEmpty" : true,
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "bearer",
      "value" : "bearer",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.type",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
        "isEmpty" : true,
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "authentication.token",
      "label" : "Access token",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.token",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "serviceAuthenticationConfiguration",
        "isEmpty" : true,
        "type" : "simple"
      },
      "tooltip" : "A Snowflake <a href='https://docs.snowflake.com/en/user-guide/programmatic-access-tokens' target='_blank'>programmatic access token</a> or an <a href='https://docs.snowflake.com/en/user-guide/oauth-ext-overview' target='_blank'>External OAuth</a> access token. Snowflake detects the token type.",
      "type" : "String",
      "secret" : true
    },
    {
      "id" : "SubmitStatement_query_requestId",
      "label" : "Request ID",
      "optional" : false,
      "constraints" : {
        "notEmpty" : false,
        "pattern" : {
          "value" : "^(=.*|[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?$",
          "message" : "Enter a UUID."
        }
      },
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "requestId",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "tooltip" : "Optional UUID that identifies this request. Leave empty to let Snowflake assign one. Snowflake answers a request ID it has seen before with the earlier result and does not run the statement again. Use a new ID for every statement you submit, also across tasks and loop iterations, and reuse it only to retry that same submission.",
      "type" : "String"
    },
    {
      "id" : "SubmitStatement_query_async",
      "label" : "Run asynchronously",
      "optional" : false,
      "value" : "false",
      "group" : "parameters",
      "binding" : {
        "name" : "async",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "tooltip" : "Set to true to return the statement handle at once. By default, Snowflake waits up to 45 seconds for the result and then returns the statement handle with HTTP 202. Get the result with <b>Get statement status</b>.",
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "true",
          "value" : "true"
        },
        {
          "name" : "false",
          "value" : "false"
        }
      ]
    },
    {
      "id" : "SubmitStatement_query_nullable",
      "label" : "Return SQL NULL as null",
      "optional" : false,
      "value" : "true",
      "group" : "parameters",
      "binding" : {
        "name" : "nullable",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "tooltip" : "Set to false to return SQL NULL values as the string 'null'.",
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "true",
          "value" : "true"
        },
        {
          "name" : "false",
          "value" : "false"
        }
      ]
    },
    {
      "id" : "SubmitStatement_$path",
      "value" : "=\"/api/v2/statements\"",
      "group" : "parameters",
      "binding" : {
        "name" : "operationPath",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "SubmitStatement_$headers",
      "value" : "={Accept: \"application/json\", \"Content-Type\": \"application/json\", \"User-Agent\": \"Camunda\"}",
      "group" : "parameters",
      "binding" : {
        "name" : "headers",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "SubmitStatement_$queryParameters",
      "value" : "=context(get entries({async: async, nullable: nullable, requestId: requestId})[value != null])",
      "group" : "parameters",
      "binding" : {
        "name" : "queryParameters",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "SubmitStatement_$method",
      "value" : "POST",
      "group" : "parameters",
      "binding" : {
        "name" : "method",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "GetStatementStatus_path_statementHandle",
      "label" : "Statement handle",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^(=.*|[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})$",
          "message" : "Enter a statement handle."
        }
      },
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "statementHandle",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "GetStatementStatus",
        "type" : "simple"
      },
      "tooltip" : "The <code>statementHandle</code> in the response body of <b>Run SQL statement</b>. While the statement runs, Get statement status returns HTTP 202 with no rows: check <code>response.status</code> and call it again later.",
      "placeholder" : "e4ce975e-f7ff-4b5e-b15e-bf25f59371ae",
      "type" : "String"
    },
    {
      "id" : "GetStatementStatus_query_requestId",
      "label" : "Request ID",
      "optional" : false,
      "constraints" : {
        "notEmpty" : false,
        "pattern" : {
          "value" : "^(=.*|[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?$",
          "message" : "Enter a UUID."
        }
      },
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "requestId",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "GetStatementStatus",
        "type" : "simple"
      },
      "tooltip" : "Optional UUID that identifies this request. Leave empty to let Snowflake assign one. Snowflake answers a request ID it has seen before with the earlier result and does not run the statement again. Use a new ID for every statement you submit, also across tasks and loop iterations, and reuse it only to retry that same submission.",
      "type" : "String"
    },
    {
      "id" : "GetStatementStatus_query_partition",
      "label" : "Partition",
      "optional" : false,
      "constraints" : {
        "notEmpty" : false,
        "pattern" : {
          "value" : "^(=.*|\\d+)?$",
          "message" : "Enter a number from 0."
        }
      },
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "partition",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "GetStatementStatus",
        "type" : "simple"
      },
      "tooltip" : "Number of the result partition to return, from 0. Large results are split into partitions: <code>resultSetMetaData.partitionInfo</code> lists them.",
      "placeholder" : "0",
      "type" : "String"
    },
    {
      "id" : "GetStatementStatus_$path",
      "value" : "=\"/api/v2/statements/\"+statementHandle",
      "group" : "parameters",
      "binding" : {
        "name" : "operationPath",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "GetStatementStatus",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "GetStatementStatus_$headers",
      "value" : "={Accept: \"application/json\", \"Content-Type\": \"application/json\", \"User-Agent\": \"Camunda\"}",
      "group" : "parameters",
      "binding" : {
        "name" : "headers",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "GetStatementStatus",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "GetStatementStatus_$queryParameters",
      "value" : "=context(get entries({partition: partition, requestId: requestId})[value != null])",
      "group" : "parameters",
      "binding" : {
        "name" : "queryParameters",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "GetStatementStatus",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "GetStatementStatus_$method",
      "value" : "GET",
      "group" : "parameters",
      "binding" : {
        "name" : "method",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "GetStatementStatus",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "CancelStatement_path_statementHandle",
      "label" : "Statement handle",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^(=.*|[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})$",
          "message" : "Enter a statement handle."
        }
      },
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "statementHandle",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "CancelStatement",
        "type" : "simple"
      },
      "tooltip" : "The <code>statementHandle</code> in the response body of <b>Run SQL statement</b>. While the statement runs, Get statement status returns HTTP 202 with no rows: check <code>response.status</code> and call it again later.",
      "placeholder" : "e4ce975e-f7ff-4b5e-b15e-bf25f59371ae",
      "type" : "String"
    },
    {
      "id" : "CancelStatement_query_requestId",
      "label" : "Request ID",
      "optional" : false,
      "constraints" : {
        "notEmpty" : false,
        "pattern" : {
          "value" : "^(=.*|[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12})?$",
          "message" : "Enter a UUID."
        }
      },
      "feel" : "optional",
      "group" : "parameters",
      "binding" : {
        "name" : "requestId",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "CancelStatement",
        "type" : "simple"
      },
      "tooltip" : "Optional UUID that identifies this request. Leave empty to let Snowflake assign one. Snowflake answers a request ID it has seen before with the earlier result and does not run the statement again. Use a new ID for every statement you submit, also across tasks and loop iterations, and reuse it only to retry that same submission.",
      "type" : "String"
    },
    {
      "id" : "CancelStatement_$path",
      "value" : "=\"/api/v2/statements/\"+statementHandle+\"/cancel\"",
      "group" : "parameters",
      "binding" : {
        "name" : "operationPath",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "CancelStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "CancelStatement_$headers",
      "value" : "={Accept: \"application/json\", \"Content-Type\": \"application/json\", \"User-Agent\": \"Camunda\"}",
      "group" : "parameters",
      "binding" : {
        "name" : "headers",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "CancelStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "CancelStatement_$queryParameters",
      "value" : "=context(get entries({requestId: requestId})[value != null])",
      "group" : "parameters",
      "binding" : {
        "name" : "queryParameters",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "CancelStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "CancelStatement_$method",
      "value" : "POST",
      "group" : "parameters",
      "binding" : {
        "name" : "method",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "CancelStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "SubmitStatement_body",
      "label" : "Request body",
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "required",
      "group" : "requestBody",
      "binding" : {
        "name" : "body",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "SubmitStatement",
        "type" : "simple"
      },
      "tooltip" : "Request body as a FEEL context. <code>statement</code> is required. Pass process variables in <a href='https://docs.snowflake.com/en/developer-guide/sql-api/submitting-requests#using-bind-variables-in-a-statement' target='_blank'><code>bindings</code></a> and use <code>?</code> in the statement, never concatenate them into the SQL. Binding values must be strings, also for numbers: use <code>string(...)</code>. Set <code>warehouse</code>, <code>database</code>, <code>schema</code> and <code>role</code> unless the user's defaults apply. If the statement takes longer than 45 seconds, the response is HTTP 202 with a <code>statementHandle</code> and no rows: get the result with <b>Get statement status</b>. See the <a href='https://docs.snowflake.com/en/developer-guide/sql-api/reference' target='_blank'>SQL API reference</a>.",
      "placeholder" : "={\n  statement: \"select * from customers where id = ?\",\n  timeout: 60,\n  database: \"MY_DB\",\n  schema: \"PUBLIC\",\n  warehouse: \"MY_WH\",\n  bindings: {\n    \"1\": {type: \"TEXT\", value: string(customerId)}\n  }\n}",
      "type" : "String"
    },
    {
      "id" : "CancelStatement_body",
      "value" : "=null",
      "group" : "requestBody",
      "binding" : {
        "name" : "body",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "operationId",
        "equals" : "CancelStatement",
        "type" : "simple"
      },
      "type" : "Hidden"
    },
    {
      "id" : "url",
      "value" : "= baseUrl + operationPath",
      "group" : "url",
      "binding" : {
        "name" : "url",
        "type" : "zeebe:input"
      },
      "type" : "Hidden"
    },
    {
      "id" : "connectionTimeoutInSeconds",
      "label" : "Connection timeout in seconds",
      "optional" : false,
      "value" : 20,
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^\\d+$",
          "message" : "Must be a number"
        }
      },
      "feel" : "static",
      "group" : "timeout",
      "binding" : {
        "name" : "connectionTimeoutInSeconds",
        "type" : "zeebe:input"
      },
      "tooltip" : "Time to establish the connection. Use 0 for an infinite timeout.",
      "type" : "Number"
    },
    {
      "id" : "readTimeoutInSeconds",
      "label" : "Read timeout in seconds",
      "optional" : false,
      "value" : 60,
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^\\d+$",
          "message" : "Must be a number"
        }
      },
      "feel" : "static",
      "group" : "timeout",
      "binding" : {
        "name" : "readTimeoutInSeconds",
        "type" : "zeebe:input"
      },
      "tooltip" : "Time to wait for the response. Snowflake waits up to 45 seconds for a result before it returns the statement handle, so keep this above 45. Use 0 for an infinite timeout.",
      "type" : "Number"
    },
    {
      "id" : "resultVariable",
      "label" : "Result variable",
      "description" : "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
      "group" : "output",
      "binding" : {
        "key" : "resultVariable",
        "type" : "zeebe:taskHeader"
      },
      "type" : "String"
    },
    {
      "id" : "resultExpression",
      "label" : "Result expression",
      "description" : "Expression to map the response into process variables. Details in the <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/use-connectors/#result-expression\" target=\"_blank\">documentation</a>.",
      "feel" : "required",
      "group" : "output",
      "binding" : {
        "key" : "resultExpression",
        "type" : "zeebe:taskHeader"
      },
      "type" : "Text"
    },
    {
      "id" : "errorExpression",
      "label" : "Error expression",
      "description" : "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
      "feel" : "required",
      "group" : "error",
      "binding" : {
        "key" : "errorExpression",
        "type" : "zeebe:taskHeader"
      },
      "type" : "Text"
    },
    {
      "id" : "retryCount",
      "label" : "Retries",
      "value" : "0",
      "feel" : "optional",
      "group" : "retries",
      "binding" : {
        "property" : "retries",
        "type" : "zeebe:taskDefinition"
      },
      "tooltip" : "Number of retries. Defaults to 0: a retried statement runs again.",
      "type" : "String"
    },
    {
      "id" : "retryBackoff",
      "label" : "Retry backoff",
      "description" : "ISO-8601 duration to wait between retries",
      "value" : "PT30S",
      "group" : "retries",
      "binding" : {
        "key" : "retryBackoff",
        "type" : "zeebe:taskHeader"
      },
      "type" : "String"
    },
    {
      "id" : "jobTimeout",
      "label" : "Job timeout",
      "description" : "ISO-8601 duration after which Zeebe considers this job timed out if not yet completed. Leave empty to use the default timeout",
      "optional" : true,
      "group" : "retries",
      "binding" : {
        "key" : "jobTimeout",
        "type" : "zeebe:taskHeader"
      },
      "type" : "String"
    },
    {
      "value" : "io.camunda:http-json:1",
      "binding" : {
        "property" : "type",
        "type" : "zeebe:taskDefinition"
      },
      "type" : "Hidden"
    }
