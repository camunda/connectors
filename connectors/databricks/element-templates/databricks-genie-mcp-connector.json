{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "Databricks Genie (MCP)",
  "id" : "io.camunda.connectors.databricks.geniemcp.v1",
  "version" : 1,
  "description" : "Ask a Databricks Genie space a natural-language question over the Genie MCP server, using the MCP Remote Client connector.",
  "keywords" : [
    "databricks",
    "genie",
    "mcp",
    "model context protocol",
    "natural language",
    "text-to-sql",
    "ai agent",
    "genie space",
    "on-behalf-of-user"
  ],
  "documentationRef" : "https://docs.databricks.com/aws/en/agents/mcp-tools/genie-mcp",
  "category" : {
    "id" : "aiTools",
    "name" : "AI Tools"
  },
  "appliesTo" : [
    "bpmn:Task"
  ],
  "elementType" : {
    "value" : "bpmn:ServiceTask"
  },
  "engines" : {
    "camunda" : "^8.9"
  },
  "icon" : {
    "contents" : "data:image/svg+xml;base64,"
  },
  "groups" : [
    { "id" : "workspace", "label" : "Databricks workspace" },
    { "id" : "authentication", "label" : "Authentication" },
    { "id" : "options", "label" : "Options" },
    { "id" : "connectorMode", "label" : "Connector mode", "tooltip" : "Select how this connector is used. When the connector is used as an AI agent tool, select the AI Agent tool mode." },
    { "id" : "operation", "label" : "Operation" },
    { "id" : "genie", "label" : "Genie question" },
    { "id" : "filters", "label" : "Filters", "openByDefault" : false },
    { "id" : "connector", "label" : "Connector" },
    { "id" : "output", "label" : "Output mapping" },
    { "id" : "error", "label" : "Error handling" },
    { "id" : "retries", "label" : "Retries" }
  ],
  "properties" : [
    {
      "type" : "Hidden",
      "description" : "Binds the element to the MCP Remote Client job worker. This is the connector's job type, not its element template id.",
      "value" : "io.camunda.agenticai:mcpremoteclient:1",
      "binding" : { "property" : "type", "type" : "zeebe:taskDefinition" }
    },
    {
      "type" : "Hidden",
      "value" : "mcpClient",
      "binding" : { "name" : "io.camunda.agenticai.gateway.type", "type" : "zeebe:property" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "aiAgentTool", "type" : "simple" }
    },
    {
      "type" : "Hidden",
      "description" : "Databricks managed MCP servers, including Genie, are served over Streamable HTTP, not SSE.",
      "value" : "http",
      "binding" : { "name" : "data.transport.type", "type" : "zeebe:input" }
    },
    {
      "id" : "databricksHost",
      "label" : "Workspace URL",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^(=|(https://|secrets|\\{\\{).*$)",
          "message" : "Must be an https URL, a FEEL expression, or a {{secrets.NAME}} placeholder"
        }
      },
      "feel" : "optional",
      "group" : "workspace",
      "binding" : { "name" : "databricksHostInput", "type" : "zeebe:input" },
      "placeholder" : "https://dbc-1234abcd-5678.cloud.databricks.com",
      "tooltip" : "Base URL of the Databricks workspace. Do not include a path, the Genie MCP path is appended automatically. A trailing slash is tolerated.",
      "type" : "String"
    },
    {
      "id" : "genieScope",
      "label" : "Genie scope",
      "value" : "space",
      "group" : "workspace",
      "binding" : { "name" : "genieScopeInput", "type" : "zeebe:input" },
      "tooltip" : "A single Genie space answers only from that space's data. Genie One answers across every space the caller can access, and no space id is configured here — if the tool response identifies which space answered, capture it in the result mapping.",
      "type" : "Dropdown",
      "choices" : [
        { "name" : "Single Genie space", "value" : "space" },
        { "name" : "Whole workspace (Genie One)", "value" : "genieOne" }
      ]
    },
    {
      "id" : "genieSpaceId",
      "label" : "Genie space ID",
      "optional" : false,
      "constraints" : { "notEmpty" : true },
      "feel" : "optional",
      "group" : "workspace",
      "binding" : { "name" : "genieSpaceIdInput", "type" : "zeebe:input" },
      "condition" : { "property" : "genieScope", "equals" : "space", "type" : "simple" },
      "tooltip" : "The id of the Genie space to call, taken from its URL in the Databricks workspace (.../genie-rooms/<id>). Databricks does not document an API to list spaces, so there is nothing here to look this up for you.",
      "type" : "String"
    },
    {
      "id" : "data.transport.http.authentication.type",
      "label" : "Type",
      "description" : "Note: Genie MCP requires on-behalf-of-user OAuth or a personal access token. Service principals and OAuth machine-to-machine (client-credentials) credentials are explicitly not supported by Databricks and will be rejected — this is confirmed against Databricks' documentation, not assumed, and differs from the Databricks REST template, which uses OAuth M2M with a service principal.",
      "value" : "bearer",
      "group" : "authentication",
      "binding" : { "name" : "data.transport.http.authentication.type", "type" : "zeebe:input" },
      "type" : "Dropdown",
      "choices" : [
        { "name" : "None (local/mock testing only)", "value" : "noAuth" },
        { "name" : "Bearer token (on-behalf-of-user)", "value" : "bearer" }
      ]
    },
    {
      "id" : "data.transport.http.authentication.token",
      "label" : "Access token",
      "optional" : false,
      "value" : "{{secrets.DATABRICKS_GENIE_ACCESS_TOKEN}}",
      "constraints" : { "notEmpty" : true },
      "feel" : "optional",
      "group" : "authentication",
      "binding" : { "name" : "data.transport.http.authentication.token", "type" : "zeebe:input" },
      "condition" : { "property" : "data.transport.http.authentication.type", "equals" : "bearer", "type" : "simple" },
      "tooltip" : "A Databricks OAuth user access token (obtained out-of-band via the interactive authorization-code + PKCE flow, or via `databricks auth login` for testing) or a personal access token. Mint it with the `genie` OAuth scope. This connector does not refresh it — user access tokens are typically valid for about an hour, so an unattended long-running process needs an external mechanism to rotate this secret.",
      "type" : "String",
      "secret" : true
    },
    {
      "id" : "data.options.clientCache",
      "label" : "Enable client caching",
      "description" : "If enabled, the MCP client instance is cached on the connector runtime and reused across requests.",
      "optional" : true,
      "feel" : "static",
      "group" : "options",
      "binding" : { "name" : "data.options.clientCache", "type" : "zeebe:input" },
      "tooltip" : "Only enable this option if you are sure that the configuration or authentication details of this client will not change between invocations.<br>Caching the client instance can improve performance by reusing existing connections. Because the access token above is short-lived and not refreshed by this connector, caching a client built from an expired token will keep failing until the client is re-created.",
      "type" : "Boolean"
    },
    {
      "id" : "data.connectorMode.type",
      "label" : "Connector mode",
      "description" : "Select how this connector is used.",
      "value" : "standalone",
      "group" : "connectorMode",
      "binding" : { "name" : "data.connectorMode.type", "type" : "zeebe:input" },
      "type" : "Dropdown",
      "choices" : [
        { "name" : "Standalone", "value" : "standalone" },
        { "name" : "AI Agent tool", "value" : "aiAgentTool" }
      ]
    },
    {
      "id" : "data.connectorMode.operation.type",
      "label" : "Operation",
      "description" : "The MCP operation to perform.",
      "value" : "tools/call",
      "group" : "operation",
      "binding" : { "name" : "data.connectorMode.operation.type", "type" : "zeebe:input" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
      "type" : "Dropdown",
      "choices" : [
        { "name" : "Call Tool", "value" : "tools/call" },
        { "name" : "List Tools (verify the live tool schema)", "value" : "tools/list" }
      ]
    },
    {
      "id" : "genieOperation",
      "label" : "Genie operation",
      "description" : "Note: Databricks does not publish a formal input schema for Genie MCP tools (no parameter table, no example request/response bodies, confirmed absent as of Aug 2026). The fields below use the best-corroborated parameter names (question, conversation_id, response_id), not a confirmed schema. Use \"List Tools\" above against your own endpoint to check the live schema before relying on this in production.",
      "value" : "ask",
      "group" : "operation",
      "binding" : { "name" : "genieOperationInput", "type" : "zeebe:input" },
      "condition" : {
        "allMatch" : [
          { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
          { "property" : "data.connectorMode.operation.type", "equals" : "tools/call", "type" : "simple" }
        ]
      },
      "type" : "Dropdown",
      "choices" : [
        { "name" : "Ask a question (genie_ask)", "value" : "ask" },
        { "name" : "Poll for a response (genie_poll_response)", "value" : "poll" },
        { "name" : "Get full query result (genie_get_query_result)", "value" : "getQueryResult" },
        { "name" : "Cancel response (genie_cancel_response)", "value" : "cancel" }
      ]
    },
    {
      "id" : "genieQuestion",
      "label" : "Question",
      "optional" : false,
      "constraints" : { "notEmpty" : true },
      "feel" : "optional",
      "group" : "genie",
      "binding" : { "name" : "genieQuestionInput", "type" : "zeebe:input" },
      "condition" : {
        "allMatch" : [
          { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
          { "property" : "data.connectorMode.operation.type", "equals" : "tools/call", "type" : "simple" },
          { "property" : "genieOperation", "equals" : "ask", "type" : "simple" }
        ]
      },
      "tooltip" : "Natural-language question for Genie. Use a FEEL expression to supply it from a process variable.",
      "type" : "Text"
    },
    {
      "id" : "genieConversationIdNew",
      "label" : "Conversation ID",
      "optional" : true,
      "feel" : "optional",
      "group" : "genie",
      "binding" : { "name" : "conversationIdInput", "type" : "zeebe:input" },
      "condition" : {
        "allMatch" : [
          { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
          { "property" : "data.connectorMode.operation.type", "equals" : "tools/call", "type" : "simple" },
          { "property" : "genieOperation", "equals" : "ask", "type" : "simple" }
        ]
      },
      "tooltip" : "Continue a previous conversation instead of starting a new one. Leave empty to start a new conversation.",
      "type" : "String"
    },
    {
      "id" : "genieConversationId",
      "label" : "Conversation ID",
      "optional" : false,
      "constraints" : { "notEmpty" : true },
      "feel" : "optional",
      "group" : "genie",
      "binding" : { "name" : "conversationIdInput", "type" : "zeebe:input" },
      "condition" : {
        "allMatch" : [
          { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
          { "property" : "data.connectorMode.operation.type", "equals" : "tools/call", "type" : "simple" },
          { "property" : "genieOperation", "oneOf" : [ "poll", "getQueryResult", "cancel" ], "type" : "simple" }
        ]
      },
      "tooltip" : "The conversation_id returned by Ask a question.",
      "type" : "String"
    },
    {
      "id" : "genieResponseId",
      "label" : "Response ID",
      "optional" : false,
      "constraints" : { "notEmpty" : true },
      "feel" : "optional",
      "group" : "genie",
      "binding" : { "name" : "responseIdInput", "type" : "zeebe:input" },
      "condition" : {
        "allMatch" : [
          { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
          { "property" : "data.connectorMode.operation.type", "equals" : "tools/call", "type" : "simple" },
          { "property" : "genieOperation", "oneOf" : [ "poll", "getQueryResult", "cancel" ], "type" : "simple" }
        ]
      },
      "tooltip" : "The response_id returned by Ask a question or by a previous poll.",
      "type" : "String"
    },
    {
      "id" : "data.connectorMode.toolOperation.method",
      "label" : "Method",
      "description" : "The MCP method to be called, e.g. <code>tools/list</code>.",
      "optional" : false,
      "value" : "=toolCall.method",
      "constraints" : { "notEmpty" : true },
      "feel" : "optional",
      "group" : "operation",
      "binding" : { "name" : "data.connectorMode.toolOperation.method", "type" : "zeebe:input" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "aiAgentTool", "type" : "simple" },
      "tooltip" : "The method to be called on the MCP server. See the <a href=\"https://modelcontextprotocol.io/specification/2024-11-05/server\">MCP specification</a> for a list of available methods.<br><br>Currently supported:<br><code>tools/list</code>, <code>tools/call</code>",
      "type" : "String"
    },
    {
      "id" : "data.connectorMode.toolOperation.params",
      "label" : "Parameters",
      "description" : "The parameters to be passed to the MCP method.",
      "optional" : true,
      "value" : "=toolCall.params",
      "feel" : "required",
      "group" : "operation",
      "binding" : { "name" : "data.connectorMode.toolOperation.params", "type" : "zeebe:input" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "aiAgentTool", "type" : "simple" },
      "tooltip" : "The parameter structure depends on the method being called. See the <a href=\"https://modelcontextprotocol.io/specification/2024-11-05/server/tools#calling-tools\">MCP specification</a> for an example of the parameters for the <code>tools/call</code> method.",
      "type" : "String"
    },
    {
      "id" : "data.connectorMode.standaloneModeFilters.tools.included",
      "label" : "Included tools",
      "description" : "List of tools that can be used by the MCP client. Defaults to the four Genie tools this template supports (excludes `view_ask`, which only works with MCP Apps-compatible clients).",
      "optional" : true,
      "value" : "=[\"genie_ask\", \"genie_poll_response\", \"genie_get_query_result\", \"genie_cancel_response\"]",
      "feel" : "required",
      "group" : "filters",
      "binding" : { "name" : "data.connectorMode.standaloneModeFilters.tools.included", "type" : "zeebe:input" },
      "condition" : {
        "allMatch" : [
          { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
          { "property" : "data.connectorMode.operation.type", "oneOf" : [ "tools/call", "tools/list" ], "type" : "simple" }
        ]
      },
      "type" : "Text"
    },
    {
      "id" : "data.connectorMode.standaloneModeFilters.tools.excluded",
      "label" : "Excluded tools",
      "description" : "List of tools that are not allowed to be used by the MCP client. Overrides any included tools.",
      "optional" : true,
      "feel" : "required",
      "group" : "filters",
      "binding" : { "name" : "data.connectorMode.standaloneModeFilters.tools.excluded", "type" : "zeebe:input" },
      "condition" : {
        "allMatch" : [
          { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" },
          { "property" : "data.connectorMode.operation.type", "oneOf" : [ "tools/call", "tools/list" ], "type" : "simple" }
        ]
      },
      "type" : "Text"
    },
    {
      "id" : "data.connectorMode.toolModeFilters.tools.included",
      "label" : "Included tools",
      "description" : "List of tools the AI Agent is allowed to call. Defaults to the four Genie tools this template supports (excludes `view_ask`, which only works with MCP Apps-compatible clients).",
      "optional" : true,
      "value" : "=[\"genie_ask\", \"genie_poll_response\", \"genie_get_query_result\", \"genie_cancel_response\"]",
      "feel" : "required",
      "group" : "filters",
      "binding" : { "name" : "data.connectorMode.toolModeFilters.tools.included", "type" : "zeebe:input" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "aiAgentTool", "type" : "simple" },
      "type" : "Text"
    },
    {
      "id" : "data.connectorMode.toolModeFilters.tools.excluded",
      "label" : "Excluded tools",
      "description" : "List of tools that the AI Agent is not allowed to call. Overrides any included tools.",
      "optional" : true,
      "feel" : "required",
      "group" : "filters",
      "binding" : { "name" : "data.connectorMode.toolModeFilters.tools.excluded", "type" : "zeebe:input" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "aiAgentTool", "type" : "simple" },
      "type" : "Text"
    },
    {
      "type" : "Hidden",
      "description" : "Workspace URL plus the Genie MCP path, and the space id when a single space is targeted.",
      "value" : "=(if ends with(databricksHostInput, \"/\") then substring(databricksHostInput, 1, string length(databricksHostInput) - 1) else databricksHostInput) + \"/api/2.0/mcp/genie\" + (if genieScopeInput = \"space\" then \"/\" + genieSpaceIdInput else \"\")",
      "binding" : { "name" : "data.transport.http.url", "type" : "zeebe:input" }
    },
    {
      "type" : "Hidden",
      "value" : "PT30S",
      "binding" : { "name" : "data.transport.http.timeout", "type" : "zeebe:input" }
    },
    {
      "type" : "Hidden",
      "description" : "Confirmed tool names per Databricks' Genie MCP documentation.",
      "value" : "=if genieOperationInput = \"ask\" then \"genie_ask\" else if genieOperationInput = \"poll\" then \"genie_poll_response\" else if genieOperationInput = \"getQueryResult\" then \"genie_get_query_result\" else \"genie_cancel_response\"",
      "binding" : { "name" : "data.connectorMode.operation.toolName", "type" : "zeebe:input" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" }
    },
    {
      "type" : "Hidden",
      "description" : "Argument key names (question, conversation_id, response_id) are the best-corroborated guess, not a Databricks-confirmed schema — see the Genie operation field's note.",
      "value" : "=if genieOperationInput = \"ask\" then context merge([{question: genieQuestionInput}, if conversationIdInput = null then {} else {conversation_id: conversationIdInput}]) else {conversation_id: conversationIdInput, response_id: responseIdInput}",
      "binding" : { "name" : "data.connectorMode.operation.toolArguments", "type" : "zeebe:input" },
      "condition" : { "property" : "data.connectorMode.type", "equals" : "standalone", "type" : "simple" }
    },
    {
      "id" : "version",
      "label" : "Version",
      "description" : "Version of the element template",
      "value" : "1",
      "group" : "connector",
      "binding" : { "key" : "elementTemplateVersion", "type" : "zeebe:taskHeader" },
      "type" : "Hidden"
    },
    {
      "id" : "id",
      "label" : "ID",
      "description" : "ID of the element template",
      "value" : "io.camunda.connectors.databricks.geniemcp.v1",
      "group" : "connector",
      "binding" : { "key" : "elementTemplateId", "type" : "zeebe:taskHeader" },
      "type" : "Hidden"
    },
    {
      "id" : "resultVariable",
      "label" : "Result variable",
      "description" : "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
      "value" : "genieResult",
      "group" : "output",
      "binding" : { "key" : "resultVariable", "type" : "zeebe:taskHeader" },
      "type" : "String"
    },
    {
      "id" : "resultExpression",
      "label" : "Result expression",
      "description" : "Note: Databricks requires anything that surfaces a Genie answer to display \"Powered by Genie\" plus a citation linking to the source Genie Space. This connector only writes process variables — it cannot render that label. Map the Genie space id (see the Workspace group) and any space/conversation link present in the tool response into your result mapping, so whatever renders the answer (a form, Tasklist, or a custom app) can display the required attribution.",
      "feel" : "required",
      "group" : "output",
      "binding" : { "key" : "resultExpression", "type" : "zeebe:taskHeader" },
      "tooltip" : "Maps the tool call result into process variables. The connector's own result is `{name, content, isError}` (confirmed from source) — `content` holds Genie's actual reply, but Databricks does not publish a formal schema for its shape, so inspect a real response (e.g. via \"List Tools\" or a test run) before finalizing this expression. See <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-expression\">result expression</a>.",
      "type" : "Text"
    },
    {
      "id" : "errorExpression",
      "label" : "Error expression",
      "description" : "Note: MCP tool errors surface as `isError: true` on the tool result rather than as an HTTP status code.",
      "value" : "=if response != null and response.isError = true then bpmnError(\"GENIE_MCP_TOOL_ERROR\", \"Genie MCP tool call returned an error: \" + string(response.content)) else null",
      "feel" : "required",
      "group" : "error",
      "binding" : { "key" : "errorExpression", "type" : "zeebe:taskHeader" },
      "tooltip" : "The default expression raises a BPMN error whenever the tool result carries `isError: true`. This only applies to Call Tool; List Tools results have no `isError` field and the expression evaluates to null (no error) for them.",
      "type" : "Text"
    },
    {
      "id" : "retryCount",
      "label" : "Retries",
      "description" : "Number of retries",
      "value" : "3",
      "feel" : "optional",
      "group" : "retries",
      "binding" : { "property" : "retries", "type" : "zeebe:taskDefinition" },
      "type" : "String"
    },
    {
      "id" : "retryBackoff",
      "label" : "Retry backoff",
      "description" : "ISO-8601 duration to wait between retries",
      "value" : "PT30S",
      "group" : "retries",
      "binding" : { "key" : "retryBackoff", "type" : "zeebe:taskHeader" },
      "type" : "String"
    },
    {
      "id" : "jobTimeout",
      "label" : "Job timeout",
      "description" : "ISO-8601 duration after which Zeebe considers this job timed out if not yet completed. Leave empty to use the default timeout",
      "optional" : true,
      "group" : "retries",
      "binding" : { "key" : "jobTimeout", "type" : "zeebe:taskHeader" },
      "type" : "String"
    }
  ]
}