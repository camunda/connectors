    {
      "id" : "additionalHeaders",
      "label" : "Additional HTTP headers",
      "optional" : true,
      "feel" : "required",
      "group" : "headers",
      "binding" : {
        "name" : "additionalHeadersInput",
        "type" : "zeebe:input"
      },
      "tooltip" : "Extra headers to send with the request. The User-Agent required for Databricks partner attribution is set by this template and cannot be overridden here.",
      "type" : "Text"
    },
    {
      "type" : "Hidden",
      "description" : "GET for read operations, POST for everything else.",
      "value" : "=if list contains([\"sql.getStatement\", \"sql.getChunk\", \"warehouse.get\", \"jobs.getRun\", \"jobs.getRunOutput\", \"serving.getEndpoint\"], operationInput) then \"GET\" else \"POST\"",
      "binding" : {
        "name" : "method",
        "type" : "zeebe:input"
      }
    },
    {
      "type" : "Hidden",
      "description" : "Workspace URL plus the operation-specific path. Model Serving invocations have no /api/2.0 prefix.",
      "value" : "=(if ends with(databricksHostInput, \"/\") then substring(databricksHostInput, 1, string length(databricksHostInput) - 1) else databricksHostInput) + (if operationInput = \"sql.execute\" then \"/api/2.0/sql/statements\" else if operationInput = \"sql.getStatement\" then \"/api/2.0/sql/statements/\" + statementIdInput else if operationInput = \"sql.cancel\" then \"/api/2.0/sql/statements/\" + statementIdInput + \"/cancel\" else if operationInput = \"sql.getChunk\" then \"/api/2.0/sql/statements/\" + statementIdInput + \"/result/chunks/\" + string(chunkIndexInput) else if operationInput = \"warehouse.get\" then \"/api/2.0/sql/warehouses/\" + warehouseIdInput else if operationInput = \"warehouse.start\" then \"/api/2.0/sql/warehouses/\" + warehouseIdInput + \"/start\" else if operationInput = \"warehouse.stop\" then \"/api/2.0/sql/warehouses/\" + warehouseIdInput + \"/stop\" else if operationInput = \"jobs.runNow\" then \"/api/2.2/jobs/run-now\" else if operationInput = \"jobs.getRun\" then \"/api/2.2/jobs/runs/get\" else if operationInput = \"jobs.getRunOutput\" then \"/api/2.2/jobs/runs/get-output\" else if operationInput = \"jobs.cancelRun\" then \"/api/2.2/jobs/runs/cancel\" else if operationInput = \"serving.getEndpoint\" then \"/api/2.0/serving-endpoints/\" + servingEndpointNameInput else if operationInput = \"vectorSearch.query\" then \"/api/2.0/vector-search/indexes/\" + vectorIndexNameInput + \"/query\" else \"/serving-endpoints/\" + servingEndpointNameInput + \"/invocations\")",
      "binding" : {
        "name" : "url",
        "type" : "zeebe:input"
      }
    },
    {
      "type" : "Hidden",
      "description" : "The Jobs run endpoints take run_id as a query parameter rather than a path segment.",
      "value" : "=if operationInput = \"jobs.getRun\" or operationInput = \"jobs.getRunOutput\" then {run_id: string(runIdInput)} else null",
      "binding" : {
        "name" : "queryParameters",
        "type" : "zeebe:input"
      }
    },
    {
      "type" : "Hidden",
      "description" : "User-Agent is merged last, with any case-insensitive user-agent key stripped first, so the partner attribution value cannot be overridden by additional headers.",
      "value" : "=context merge(concatenate((for e in get entries(if additionalHeadersInput = null then {} else additionalHeadersInput) return if lower case(e.key) = \"user-agent\" then {} else context put({}, e.key, e.value)), [{\"User-Agent\": \"Camunda_DatabricksConnector/1.0\"}]))",
      "binding" : {
        "name" : "headers",
        "type" : "zeebe:input"
      }
    },
    {
      "type" : "Hidden",
      "description" : "Operation-specific request body. Null optional fields are omitted, GET operations send no body, and for chat stream is merged last so it stays false.",
      "value" : "=if operationInput = \"sql.execute\" then context merge([ {statement: sqlStatementTextInput, warehouse_id: sqlWarehouseIdInput, wait_timeout: sqlWaitTimeoutInput, on_wait_timeout: sqlOnWaitTimeoutInput, disposition: sqlDispositionInput, format: \"JSON_ARRAY\"}, if sqlCatalogInput = null then {} else {catalog: sqlCatalogInput}, if sqlSchemaInput = null then {} else {schema: sqlSchemaInput}, if sqlParametersInput = null then {} else {parameters: sqlParametersInput}]) else if operationInput = \"serving.chat\" then context merge([ if chatExtraParamsInput = null then {} else chatExtraParamsInput, if chatMaxTokensInput = null then {} else {max_tokens: chatMaxTokensInput}, if chatTemperatureInput = null then {} else {temperature: chatTemperatureInput}, {messages: chatMessagesInput, stream: false}]) else if operationInput = \"serving.raw\" then servingRawPayloadInput else if operationInput = \"jobs.runNow\" then context merge([{job_id: jobIdInput}, if jobParametersInput = null then {} else {job_parameters: jobParametersInput}, if idempotencyTokenInput = null then {} else {idempotency_token: idempotencyTokenInput}]) else if operationInput = \"jobs.cancelRun\" then {run_id: runIdInput} else if operationInput = \"vectorSearch.query\" then vectorQueryPayloadInput else if list contains([\"sql.cancel\", \"warehouse.start\", \"warehouse.stop\"], operationInput) then {} else null",
      "binding" : {
        "name" : "body",
        "type" : "zeebe:input"
      }
    },
    {
      "id" : "readTimeoutInSeconds",
      "label" : "Read timeout in seconds",
      "optional" : false,
      "value" : 60,
      "constraints" : {
        "notEmpty" : true,
