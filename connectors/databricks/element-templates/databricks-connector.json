{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "Databricks",
  "id" : "io.camunda.connectors.databricks.rest.v1",
  "version" : 1,
  "description" : "Call the Databricks SQL Statement Execution, SQL Warehouses, Jobs, Model Serving, and Vector Search REST APIs from a BPMN process.",
  "keywords" : [
    "databricks",
    "sql statement execution",
    "sql warehouse",
    "jobs",
    "run job",
    "model serving",
    "llm inference",
    "vector search",
    "lakehouse",
    "unity catalog",
    "oauth m2m",
    "service principal"
  ],
  "documentationRef" : "https://docs.databricks.com/api/workspace/introduction",
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [
    "bpmn:Task"
  ],
  "elementType" : {
    "value" : "bpmn:ServiceTask"
  },
  "engines" : {
    "camunda" : "^8.9"
  },
  "icon" : {
    "contents" : "data:image/svg+xml;base64,"
  },
  "groups" : [
    {
      "id" : "workspace",
      "label" : "Databricks workspace"
    },
    {
      "id" : "operation",
      "label" : "Operation"
    },
    {
      "id" : "authentication",
      "label" : "Authentication"
    },
    {
      "id" : "sql",
      "label" : "SQL statement"
    },
    {
      "id" : "warehouse",
      "label" : "SQL warehouse"
    },
    {
      "id" : "jobs",
      "label" : "Job run"
    },
    {
      "id" : "modelServing",
      "label" : "Model Serving"
    },
    {
      "id" : "vectorSearch",
      "label" : "Vector Search"
    },
    {
      "id" : "headers",
      "label" : "HTTP headers"
    },
    {
      "id" : "timeout",
      "label" : "Timeouts"
    },
    {
      "id" : "output",
      "label" : "Output mapping"
    },
    {
      "id" : "error",
      "label" : "Error handling"
    },
    {
      "id" : "retries",
      "label" : "Retries"
    }
  ],
  "properties" : [
    {
      "type" : "Hidden",
      "description" : "Binds the element to the REST protocol connector job worker.",
      "value" : "io.camunda:http-json:1",
      "binding" : {
        "property" : "type",
        "type" : "zeebe:taskDefinition"
      }
    },
    {
      "id" : "databricksHost",
      "label" : "Workspace URL",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^(=|(https://|secrets|\\{\\{).*$)",
          "message" : "Must be an https URL, a FEEL expression, or a {{secrets.NAME}} placeholder"
        }
      },
      "feel" : "optional",
      "group" : "workspace",
      "binding" : {
        "name" : "databricksHostInput",
        "type" : "zeebe:input"
      },
      "placeholder" : "https://dbc-1234abcd-5678.cloud.databricks.com",
      "tooltip" : "Base URL of the Databricks workspace. Do not include a path, the operation-specific path is appended automatically. A trailing slash is tolerated.",
      "type" : "String"
    },
    {
      "id" : "service",
      "label" : "Databricks API",
      "optional" : false,
      "value" : "sql",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "operation",
      "binding" : {
        "name" : "serviceInput",
        "type" : "zeebe:input"
      },
      "tooltip" : "Which Databricks API to call. The operation list below changes to match.",
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "SQL Statement Execution",
          "value" : "sql"
        },
        {
          "name" : "SQL Warehouses",
          "value" : "warehouse"
        },
        {
          "name" : "Jobs",
          "value" : "jobs"
        },
        {
          "name" : "Model Serving",
          "value" : "modelServing"
        },
        {
          "name" : "Vector Search",
          "value" : "vectorSearch"
        }
      ]
    },
    {
      "id" : "sqlOperation",
      "label" : "Operation",
      "optional" : false,
      "value" : "sql.execute",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "operation",
      "binding" : {
        "name" : "operationInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "service",
        "type" : "simple",
        "equals" : "sql"
      },
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "Execute statement (POST /api/2.0/sql/statements)",
          "value" : "sql.execute"
        },
        {
          "name" : "Get statement status and result (GET /api/2.0/sql/statements/{id})",
          "value" : "sql.getStatement"
        },
        {
          "name" : "Get result chunk (GET .../result/chunks/{index})",
          "value" : "sql.getChunk"
        },
        {
          "name" : "Cancel statement (POST .../cancel)",
          "value" : "sql.cancel"
        }
      ]
    },
    {
      "id" : "warehouseOperation",
      "label" : "Operation",
      "optional" : false,
      "value" : "warehouse.get",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "operation",
      "binding" : {
        "name" : "operationInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "service",
        "type" : "simple",
        "equals" : "warehouse"
      },
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "Get warehouse (GET /api/2.0/sql/warehouses/{id})",
          "value" : "warehouse.get"
        },
        {
          "name" : "Start warehouse (POST .../start)",
          "value" : "warehouse.start"
        },
        {
          "name" : "Stop warehouse (POST .../stop)",
          "value" : "warehouse.stop"
        }
      ]
    },
    {
      "id" : "jobsOperation",
      "label" : "Operation",
      "optional" : false,
      "value" : "jobs.runNow",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "operation",
      "binding" : {
        "name" : "operationInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "service",
        "type" : "simple",
        "equals" : "jobs"
      },
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "Run job now (POST /api/2.2/jobs/run-now)",
          "value" : "jobs.runNow"
        },
        {
          "name" : "Get run (GET /api/2.2/jobs/runs/get)",
          "value" : "jobs.getRun"
        },
        {
          "name" : "Get run output (GET /api/2.2/jobs/runs/get-output)",
          "value" : "jobs.getRunOutput"
        },
        {
          "name" : "Cancel run (POST /api/2.2/jobs/runs/cancel)",
          "value" : "jobs.cancelRun"
        }
      ]
    },
    {
      "id" : "servingOperation",
      "label" : "Operation",
      "optional" : false,
      "value" : "serving.chat",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "operation",
      "binding" : {
        "name" : "operationInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "service",
        "type" : "simple",
        "equals" : "modelServing"
      },
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "Invoke chat / LLM endpoint (POST /serving-endpoints/{name}/invocations)",
          "value" : "serving.chat"
        },
        {
          "name" : "Invoke custom model, raw payload (POST /serving-endpoints/{name}/invocations)",
          "value" : "serving.raw"
        },
        {
          "name" : "Get endpoint (GET /api/2.0/serving-endpoints/{name})",
          "value" : "serving.getEndpoint"
        }
      ]
    },
    {
      "id" : "vectorSearchOperation",
      "label" : "Operation",
      "optional" : false,
      "value" : "vectorSearch.query",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "operation",
      "binding" : {
        "name" : "operationInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "service",
        "type" : "simple",
        "equals" : "vectorSearch"
      },
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "Query index (POST /api/2.0/vector-search/indexes/{name}/query)",
          "value" : "vectorSearch.query"
        }
      ]
    },
    {
      "id" : "authentication.type",
      "label" : "Type",
      "optional" : false,
      "value" : "oauth-client-credentials-flow",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.type",
        "type" : "zeebe:input"
      },
      "tooltip" : "OAuth M2M with a service principal is the recommended method for production. See <a href=\"https://docs.databricks.com/aws/en/dev-tools/auth/oauth-m2m\">Databricks OAuth M2M</a>.",
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "OAuth M2M (service principal)",
          "value" : "oauth-client-credentials-flow"
        },
        {
          "name" : "Personal access token (testing only)",
          "value" : "bearer"
        }
      ]
    },
    {
      "id" : "authentication.clientId",
      "label" : "Client ID",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.clientId",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "authentication.type",
        "type" : "simple",
        "equals" : "oauth-client-credentials-flow"
      },
      "tooltip" : "Application ID of the Databricks service principal.",
      "type" : "String"
    },
    {
      "id" : "authentication.clientSecret",
      "label" : "Client secret",
      "optional" : false,
      "value" : "{{secrets.DATABRICKS_CLIENT_SECRET}}",
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.clientSecret",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "authentication.type",
        "type" : "simple",
        "equals" : "oauth-client-credentials-flow"
      },
      "tooltip" : "OAuth secret of the service principal. Reference it as a connector secret rather than entering the value directly.",
      "type" : "String",
      "secret" : true
    },
    {
      "id" : "authentication.token",
      "label" : "Personal access token",
      "description" : "Note: intended for testing only. Use OAuth M2M in production.",
      "optional" : false,
      "value" : "{{secrets.DATABRICKS_TOKEN}}",
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "authentication",
      "binding" : {
        "name" : "authentication.token",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "authentication.type",
        "type" : "simple",
        "equals" : "bearer"
      },
      "type" : "String",
      "secret" : true
    },
    {
      "type" : "Hidden",
      "description" : "Workspace-level OAuth token endpoint, derived from the workspace URL.",
      "value" : "=(if ends with(databricksHostInput, \"/\") then substring(databricksHostInput, 1, string length(databricksHostInput) - 1) else databricksHostInput) + \"/oidc/v1/token\"",
      "binding" : {
        "name" : "authentication.oauthTokenEndpoint",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "authentication.type",
        "type" : "simple",
        "equals" : "oauth-client-credentials-flow"
      }
    },
    {
      "type" : "Hidden",
      "description" : "Databricks requires the client credentials as a Basic Auth header.",
      "value" : "basicAuthHeader",
      "binding" : {
        "name" : "authentication.clientAuthentication",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "authentication.type",
        "type" : "simple",
        "equals" : "oauth-client-credentials-flow"
      }
    },
    {
      "type" : "Hidden",
      "description" : "Grants access to every Databricks REST API the principal is permitted to call.",
      "value" : "all-apis",
      "binding" : {
        "name" : "authentication.scopes",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "authentication.type",
        "type" : "simple",
        "equals" : "oauth-client-credentials-flow"
      }
    },
    {
      "id" : "servingEndpointName",
      "label" : "Serving endpoint name",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "modelServing",
      "binding" : {
        "name" : "servingEndpointNameInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "servingOperation",
        "type" : "simple",
        "oneOf" : [
          "serving.chat",
          "serving.raw",
          "serving.getEndpoint"
        ]
      },
      "placeholder" : "databricks-meta-llama-3-3-70b-instruct",
      "type" : "String"
    },
    {
      "id" : "chatMessages",
      "label" : "Messages",
      "optional" : false,
      "value" : "=[\n  {role: \"user\", content: \"Hello\"}\n]",
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "required",
      "group" : "modelServing",
      "binding" : {
        "name" : "chatMessagesInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "servingOperation",
        "type" : "simple",
        "equals" : "serving.chat"
      },
      "tooltip" : "List of chat messages. Each entry needs a role of system, user, or assistant, and a content string.",
      "type" : "Text"
    },
    {
      "id" : "chatMaxTokens",
      "label" : "Max tokens",
      "optional" : true,
      "feel" : "optional",
      "group" : "modelServing",
      "binding" : {
        "name" : "chatMaxTokensInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "servingOperation",
        "type" : "simple",
        "equals" : "serving.chat"
      },
      "tooltip" : "Leave blank to use the endpoint default. Databricks reserves tokens up front, so an oversized value can be rejected with HTTP 429 before the request is processed.",
      "type" : "Number"
    },
    {
      "id" : "chatTemperature",
      "label" : "Temperature",
      "description" : "Between 0.0 and 2.0.",
      "optional" : true,
      "feel" : "optional",
      "group" : "modelServing",
      "binding" : {
        "name" : "chatTemperatureInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "servingOperation",
        "type" : "simple",
        "equals" : "serving.chat"
      },
      "tooltip" : "Leave blank to use the endpoint default of 1.0.",
      "type" : "Number"
    },
    {
      "id" : "chatExtraParams",
      "label" : "Additional chat parameters",
      "optional" : true,
      "feel" : "required",
      "group" : "modelServing",
      "binding" : {
        "name" : "chatExtraParamsInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "servingOperation",
        "type" : "simple",
        "equals" : "serving.chat"
      },
      "tooltip" : "Extra parameters merged into the request body, for anything not exposed as its own field: top_p, top_k, tools, tool_choice, response_format, logprobs, reasoning_effort. Streaming stays disabled and cannot be re-enabled here.",
      "type" : "Text"
    },
    {
      "id" : "servingRawPayload",
      "label" : "Request payload",
      "optional" : false,
      "value" : "={\n  dataframe_split: {\n    columns: [\"feature_a\", \"feature_b\"],\n    data: [[1, 2]]\n  }\n}",
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "required",
      "group" : "modelServing",
      "binding" : {
        "name" : "servingRawPayloadInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "servingOperation",
        "type" : "simple",
        "equals" : "serving.raw"
      },
      "tooltip" : "Full request body for a custom model endpoint, using exactly one of dataframe_split, dataframe_records, inputs, or instances. Prefer dataframe_split, because dataframe_records does not guarantee column ordering. See <a href=\"https://docs.databricks.com/api/workspace/servingendpoints/query\">Model Serving query API</a>.",
      "type" : "Text"
    },
    {
      "id" : "sqlWarehouseId",
      "label" : "Warehouse ID",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "sql",
      "binding" : {
        "name" : "sqlWarehouseIdInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "placeholder" : "1234567890abcdef",
      "type" : "String"
    },
    {
      "id" : "sqlStatementText",
      "label" : "SQL statement",
      "description" : "Warning: bind values as parameters below. Never concatenate process variables into this text. Maximum statement size 16 MiB.",
      "optional" : false,
      "value" : "SELECT * FROM samples.nyctaxi.trips WHERE fare_amount > :min_fare LIMIT 10",
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "sql",
      "binding" : {
        "name" : "sqlStatementTextInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "tooltip" : "Named markers such as :min_fare are supported. Positional question-mark markers are not supported by the Databricks SQL Statement Execution API.",
      "type" : "Text"
    },
    {
      "id" : "sqlParameters",
      "label" : "Statement parameters",
      "optional" : true,
      "value" : "=[\n  {name: \"min_fare\", value: \"10.0\", type: \"DECIMAL(10,2)\"}\n]",
      "feel" : "required",
      "group" : "sql",
      "binding" : {
        "name" : "sqlParametersInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "tooltip" : "List of name, value, and type entries, and the only injection-safe way to pass values into the statement. The name omits the leading colon, type defaults to STRING, and omitting value binds NULL. Complex types such as ARRAY, MAP, and STRUCT are not supported.",
      "type" : "Text"
    },
    {
      "id" : "sqlCatalog",
      "label" : "Catalog",
      "optional" : true,
      "feel" : "optional",
      "group" : "sql",
      "binding" : {
        "name" : "sqlCatalogInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "placeholder" : "main",
      "type" : "String"
    },
    {
      "id" : "sqlSchema",
      "label" : "Schema",
      "optional" : true,
      "feel" : "optional",
      "group" : "sql",
      "binding" : {
        "name" : "sqlSchemaInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "placeholder" : "default",
      "type" : "String"
    },
    {
      "id" : "sqlWaitTimeout",
      "label" : "Wait timeout",
      "description" : "Either 0s, or between 5s and 50s.",
      "optional" : false,
      "value" : "30s",
      "constraints" : {
        "notEmpty" : true,
        "pattern" : {
          "value" : "^(=.*|0s|[5-9]s|[1-4][0-9]s|50s)$",
          "message" : "Must be 0s, or between 5s and 50s"
        }
      },
      "feel" : "optional",
      "group" : "sql",
      "binding" : {
        "name" : "sqlWaitTimeoutInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "tooltip" : "How long to wait inline for the statement to finish. 0s returns immediately. If the statement does not finish within the window, the response carries a non-terminal state and the result must be polled with the Get statement operation.",
      "type" : "String"
    },
    {
      "id" : "sqlOnWaitTimeout",
      "label" : "On wait timeout",
      "optional" : false,
      "value" : "CONTINUE",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "sql",
      "binding" : {
        "name" : "sqlOnWaitTimeoutInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "CONTINUE - keep running, poll for the result",
          "value" : "CONTINUE"
        },
        {
          "name" : "CANCEL - cancel the statement on timeout",
          "value" : "CANCEL"
        }
      ]
    },
    {
      "id" : "sqlDisposition",
      "label" : "Disposition",
      "optional" : false,
      "value" : "INLINE",
      "constraints" : {
        "notEmpty" : true
      },
      "group" : "sql",
      "binding" : {
        "name" : "sqlDispositionInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "equals" : "sql.execute"
      },
      "tooltip" : "How results are returned. INLINE embeds rows in the response and is capped at 25 MiB, and exceeding the cap aborts the statement without a result set. EXTERNAL_LINKS returns presigned URLs that expire after 15 minutes and must be fetched without an Authorization header.",
      "type" : "Dropdown",
      "choices" : [
        {
          "name" : "INLINE - rows in the response (max 25 MiB)",
          "value" : "INLINE"
        },
        {
          "name" : "EXTERNAL_LINKS - presigned download URLs",
          "value" : "EXTERNAL_LINKS"
        }
      ]
    },
    {
      "id" : "statementId",
      "label" : "Statement ID",
      "optional" : false,
      "constraints" : {
        "notEmpty" : true
      },
      "feel" : "optional",
      "group" : "sql",
      "binding" : {
        "name" : "statementIdInput",
        "type" : "zeebe:input"
      },
      "condition" : {
        "property" : "sqlOperation",
        "type" : "simple",
        "oneOf" : [
          "sql.getStatement",
          "sql.getChunk",
          "sql.cancel"
        ]
      },
      "tooltip" : "The statement_id returned by the Execute statement operation. Statements are removed roughly 12 hours after reaching a terminal state, after which these calls return HTTP 404.",
