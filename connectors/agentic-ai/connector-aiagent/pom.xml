  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze-dependencies</id>
            <configuration>
              <ignoredDependencies>
                <!-- needed on the compile classpath for the RecordBuilder annotation processor to
                     resolve the @AgenticAiRecord meta-annotation; no bytecode reference remains -->
                <ignoredDependency>io.soabase.record-builder:record-builder-core</ignoredDependency>
                <!-- main code references ConfigurableBeanFactory only through an inlined constant, so
                     no bytecode reference to spring-beans remains -->
                <ignoredDependency>org.springframework:spring-beans</ignoredDependency>
                <!-- guava is compile-scoped for javac's benefit only (see the dependency
                     declaration above): main code never imports it, so the analyzer would
                     otherwise flag it as a non-test scoped test-only dependency. -->
                <ignoredDependency>com.google.guava:guava</ignoredDependency>
                <!-- compile-scoped for javac's benefit only (see the dependency declaration above) -->
                <ignoredDependency>software.amazon.awssdk:http-auth-spi</ignoredDependency>
              </ignoredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
