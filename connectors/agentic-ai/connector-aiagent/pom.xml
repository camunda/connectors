    <!-- Per-template-id default system prompt deviations, one "templateId=file" tuple per line.
         A template whose id has no entry here keeps the generator's own default
         (PromptConfiguration.DEFAULT_SYSTEM_PROMPT). Today this holds only the v1 deviation: the
         legacy <thinking> XML scaffold that DEFAULT_SYSTEM_PROMPT (the v2 default) dropped in
         favor of each provider's native reasoning/thinking configuration. -->
    <systemPromptOverrides>
io.camunda.connectors.agenticai.aiagent.v1=${project.basedir}/element-template-overrides/v1-legacy-system-prompt.txt
io.camunda.connectors.agenticai.aiagent.v1-hybrid=${project.basedir}/element-template-overrides/v1-legacy-system-prompt.txt
io.camunda.connectors.agenticai.aiagent.jobworker.v1=${project.basedir}/element-template-overrides/v1-legacy-system-prompt.txt
io.camunda.connectors.agenticai.aiagent.jobworker.v1-hybrid=${project.basedir}/element-template-overrides/v1-legacy-system-prompt.txt
