    <!--
      REQUIRED: google-genai shades KotlinModule into com.google.genai.shaded.* but ships a
      META-INF/services entry pointing at the unshaded class, so
      ObjectMapper.findAndRegisterModules() (called by langchain4j-core) throws
      ServiceConfigurationError without the Kotlin module on the class path. Do not exclude it.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-kotlin</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- main code imports com.google.genai.* directly (we build the Client ourselves) -->
    <dependency>
      <groupId>com.google.genai</groupId>
      <artifactId>google-genai</artifactId>
    </dependency>

    <!--
      Declared directly rather than via the com.anthropic:anthropic-java aggregator:
      anthropic-java-core (the com.anthropic.models.* classes) and anthropic-java-client-okhttp
      (the OkHttp-based AnthropicClient builder used by AnthropicChatModelApiFactory, plus the
      ProxyAuthenticator used for proxy credentials) share the aggregator's version.
    -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java-core</artifactId>
      <version>${version.anthropic-java}</version>
    </dependency>
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java-client-okhttp</artifactId>
      <version>${version.anthropic-java}</version>
    </dependency>

    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java-bedrock</artifactId>
      <version>${version.anthropic-java}</version>
    </dependency>

    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java-foundry</artifactId>
      <version>${version.anthropic-java}</version>
    </dependency>

    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java-core</artifactId>
      <version>${version.openai-java}</version>
    </dependency>
    <dependency>
      <groupId>com.openai</groupId>
      <artifactId>openai-java-client-okhttp</artifactId>
      <version>${version.openai-java}</version>
    </dependency>

    <!--
      OkHttp 5 split into multi-platform modules: the `okhttp` artifact's pom is now an empty
      shell (classes ship in `okhttp-jvm`), see the comment in parent/pom.xml. Both anthropic-java
      and openai-java's okhttp clients (Stainless-generated) only depend on the empty `okhttp`
      shell, so their builders throw NoClassDefFoundError at runtime unless we add `okhttp-jvm`
      explicitly (same pattern as connectors/slack and connectors/microsoft/common).
    -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp-jvm</artifactId>
      <version>${version.okhttp}</version>
    </dependency>

