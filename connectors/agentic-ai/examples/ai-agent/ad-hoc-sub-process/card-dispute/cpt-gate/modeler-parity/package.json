{
  "name": "cpt-gate-modeler-parity",
  "private": true,
  "type": "module",
  "description": "Modeler 5.51.1 parity checks for the CPT done-gate (dependency versions pinned to camunda-modeler v5.51.1 package-lock.json)",
  "scripts": {
    "build": "esbuild parity.mjs --bundle --platform=node --format=esm --outfile=dist/parity.mjs --log-level=error --loader:.css=empty --external:jsdom --banner:js=\"import {createRequire} from 'module';const require=createRequire(import.meta.url);\"",
