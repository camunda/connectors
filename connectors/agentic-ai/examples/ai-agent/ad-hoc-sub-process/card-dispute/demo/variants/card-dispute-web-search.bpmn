<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="CardDisputeDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="CardDispute" name="Card dispute" isExecutable="true">
    <bpmn:startEvent id="DisputeReceived" name="Dispute received">
      <bpmn:outgoing>Flow_ToAgentInput</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="JoinAgentInput">
      <bpmn:incoming>Flow_ToAgentInput</bpmn:incoming>
      <bpmn:incoming>Flow_Revise</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:adHocSubProcess id="DisputeAgent" name="Dispute agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="completions" target="provider.openai.api.type" />
          <zeebe:input source="custom" target="provider.openai.backend.type" />
          <zeebe:input source="=camunda.vars.env.cardDisputeLlmGlobal" target="provider.openai.backend.custom.openAiCustomCredential" />
          <zeebe:input source="=[{type: &#34;web_search&#34;, parameters: {maxResults: 3, allowedDomains: [&#34;mastercard.com&#34;]}}]" target="provider.openai.api.completions.serverTools" />
          <zeebe:input source="=&#34;You are the first-line card dispute analyst. Follow the governed compliance policy below. Reconcile the transaction export with the ReconcileTransactions tool: pass the export file name transactions-2026-09.csv, the merchant, and the disputed amount. Quote its matchCount, overchargeAmount, and refundTotal. Do not calculate transaction amounts from memory. Fetch the network rule before reconciliation. Also use the provider web search, limited to mastercard.com, to find the published duplicate-processing rule, and cite its source URL in the evidence. The fetched network rule stays authoritative for the decision. Then use the Daytona sandbox for the date arithmetic: import the attached transactions-2026-09.csv with sandbox_import_document to /home/daytona/transactions-2026-09.csv (the writable sandbox directory is /home/daytona, not /workspace), and run Python that returns timeLimitDays, lastChargeDate, filingDeadline, and daysBetweenCharges. Compute filingDeadline with Python datetime as the last duplicate charge date plus timeLimitDays. Never calculate dates yourself. Quote the sandbox filingDeadline in the decision evidence. Call AskFraudRiskAgent at most once per dispute. Include the real fraud opinion as an evidence item starting with Fraud risk agent:. Return the decision JSON required by the policy, without Markdown fences.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=if is defined(followUpInput) and followUpInput != null then followUpInput else &#34;New card dispute &#34; + disputeId + &#34;. Cardholder: &#34; + cardholderName + &#34;, card ending &#34; + cardLast4 + &#34;. Claim: &#34; + claim + &#34; Disputed amount: &#34; + string(disputedAmount) + &#34;. The statement and the transaction export (transactions-2026-09.csv) are attached as documents. Investigate with your tools. Pass the export document to the reconciliation tool by file name. Then draft a decision. Reply with only the JSON object from the policy Output section, using exactly the keys decision, refundAmount, reasonCode, policyVersion, rationale and evidence. The decision field must be exactly one of APPROVE, ESCALATE or DENY.&#34;" target="data.userPrompt.prompt" />
          <zeebe:input source="=disputeDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="=agent.context" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=12" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="true" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="instructionSource" value="resource" />
          <zeebe:header key="systemPromptBinding" value="latest" />
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="dispute-compliance-policy.md" resourceType="system-prompt" linkName="systemPrompt" bindingType="latest" />
        </zeebe:linkedResources>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
      <bpmn:serviceTask id="FetchCardNetworkRules" name="Fetch card network rules" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Fetch the card network's dispute rules for one dispute category. Returns the rule reference, the eligibility conditions, the time limit, and the evidence required. Call this before you recommend a reason code.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=clusterApiUrl + &#34;/v2/resources/&#34; + cardRulesKey + &#34;/content/binary?category=&#34; + fromAi(toolCall.disputeCategory, &#34;Dispute category: duplicate, not_received, fraud, or other&#34;)" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="TEXT" target="documentReturnFormat.choice" />
            <zeebe:input source="UTF-8" target="documentReturnFormat.encoding" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="18" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={toolCallResult: response.body}" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
            <bpmn:subProcess id="ReconcileTransactions" name="Reconcile transactions (document in)">
        <bpmn:documentation>Reconcile a transaction export document for one merchant and amount. Pass the file name of the export document you hold (for example transactions-2026-09.csv). Returns the matching charges, refunds already posted for that merchant, whether a duplicate is confirmed, the days between charges, the overcharge amount, and the source document. Use this for all arithmetic over transactions.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.documentName, &#34;File name of the transaction export document, for example transactions-2026-09.csv&#34;)" target="docName" />
            <zeebe:input source="=fromAi(toolCall.merchant, &#34;Merchant name exactly as it appears in the export, for example Northwind Electronics&#34;)" target="disputedMerchant" />
            <zeebe:input source="=fromAi(toolCall.amount, &#34;Disputed charge amount&#34;, &#34;number&#34;)" target="disputedAmount" />
            <zeebe:output source="=toolCallResult" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="Reconcile_Start" name="Tool called"><bpmn:outgoing>Reconcile_F1</bpmn:outgoing></bpmn:startEvent>
        <bpmn:sequenceFlow id="Reconcile_F1" sourceRef="Reconcile_Start" targetRef="Reconcile_Resolve" />
        <bpmn:serviceTask id="Reconcile_ReadDocument" name="Read export document" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
            <zeebe:ioMapping>
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="GET" target="method" />
              <zeebe:input source="=clusterApiUrl + &#34;/v2/documents/&#34; + sourceDocument.documentId + &#34;?storeId=&#34; + sourceDocument.storeId + &#34;&amp;contentHash=&#34; + sourceDocument.contentHash" target="url" />
              <zeebe:input source="=false" target="followRedirects" />
              <zeebe:input source="TEXT" target="documentReturnFormat.choice" />
              <zeebe:input source="UTF-8" target="documentReturnFormat.encoding" />
              <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="=20" target="readTimeoutInSeconds" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="elementTemplateVersion" value="18" />
              <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
              <zeebe:header key="resultExpression" value="={exportCsv: response.body}" />
              <zeebe:header key="retryBackoff" value="PT30S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements><bpmn:incoming>Reconcile_F0</bpmn:incoming><bpmn:outgoing>Reconcile_F2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Reconcile_F0" sourceRef="Reconcile_Resolve" targetRef="Reconcile_ReadDocument" />
        <bpmn:scriptTask id="Reconcile_Resolve" name="Resolve document handle">
          <bpmn:extensionElements>
            <zeebe:script expression="=disputeDocuments[metadata.fileName = docName][1]" resultVariable="sourceDocument" />
          </bpmn:extensionElements><bpmn:incoming>Reconcile_F1</bpmn:incoming><bpmn:outgoing>Reconcile_F0</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:sequenceFlow id="Reconcile_F2" sourceRef="Reconcile_ReadDocument" targetRef="Reconcile_Compute" />
        <bpmn:scriptTask id="Reconcile_Compute" name="Reconcile">
          <bpmn:extensionElements>
            <zeebe:script expression="={lines: split(exportCsv, &#34;\r?\n&#34;)[item != &#34;&#34;], header: split(lines[1], &#34;,&#34;), iId: index of(header, &#34;id&#34;)[1], iDate: index of(header, &#34;date&#34;)[1], iMerchant: index of(header, &#34;merchant&#34;)[1], iAmount: index of(header, &#34;amount&#34;)[1], rows: for line in sublist(lines, 2) return {id: split(line, &#34;,&#34;)[iId], date: split(line, &#34;,&#34;)[iDate], merchant: split(line, &#34;,&#34;)[iMerchant], amount: number(split(line, &#34;,&#34;)[iAmount])}, matches: rows[merchant = disputedMerchant and amount = disputedAmount], matchCount: count(matches), refundsPosted: rows[merchant = disputedMerchant and amount &#60; 0], refundTotal: if count(refundsPosted) = 0 then 0 else -sum(refundsPosted.amount), result: {method: &#34;Read the export document, matched on merchant and amount, then listed refunds already posted for that merchant&#34;, sourceDocument: sourceDocument.metadata.fileName, rowsRead: count(rows), matches: matches, matchCount: matchCount, refundsPosted: refundsPosted, refundTotal: refundTotal, duplicateConfirmed: matchCount &#62;= 2, daysBetweenCharges: if matchCount &#62;= 2 then (date(matches[2].date) - date(matches[1].date)).days else null, overchargeAmount: if matchCount &#62;= 2 then disputedAmount * (matchCount - 1) else 0}}.result" resultVariable="toolCallResult" />
          </bpmn:extensionElements><bpmn:incoming>Reconcile_F2</bpmn:incoming><bpmn:outgoing>Reconcile_F3</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:sequenceFlow id="Reconcile_F3" sourceRef="Reconcile_Compute" targetRef="Reconcile_End" />
        <bpmn:endEvent id="Reconcile_End" name="Reconciled"><bpmn:incoming>Reconcile_F3</bpmn:incoming></bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:serviceTask id="AnalyzeInSandbox" name="Analyze in sandbox (Daytona)" zeebe:modelerTemplate="io.camunda.connectors.agenticai.sandbox.daytona.v0" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Isolated Daytona sandbox to run generated Python over imported documents. Use it for date arithmetic such as the filing deadline, and to cross-check the reconciliation.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="{{secrets.DAYTONA_API_KEY}}" target="data.apiKey" />
            <zeebe:input source="DURATION" target="data.autoStop.mode" />
            <zeebe:input source="PT1H" target="data.autoStop.duration" />
            <zeebe:input source="DEFAULT" target="data.autoArchive.mode" />
            <zeebe:input source="DURATION" target="data.autoDelete.mode" />
            <zeebe:input source="PT2H" target="data.autoDelete.duration" />
            <zeebe:input source="aiAgentTool" target="data.connectorMode.type" />
            <zeebe:input source="=toolCall" target="data.connectorMode.toolCall" />
          </zeebe:ioMapping>
          <zeebe:taskDefinition type="io.camunda.agenticai:sandboxdaytona:1" retries="3" />
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="1" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.sandbox.daytona.v0" />
            <zeebe:header key="resultVariable" value="toolCallResult" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
          <zeebe:properties>
            <zeebe:property name="io.camunda.agenticai.gateway.type" value="sandbox" />
          </zeebe:properties>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:subProcess id="AskFraudRiskAgent" name="Ask fraud risk agent">
        <bpmn:documentation>Ask the bank's external fraud risk agent for a risk opinion on this dispute, over A2A. Returns the agent's answer as text. Call this once per dispute. It waits until the agent has answered.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.question, &#34;What you want the fraud agent to assess, including merchant, amount, dates, transaction references, and the cardholder claim&#34;)" target="text" />
            <zeebe:input source="=null" target="a2a" />
            <zeebe:input source="=0" target="attempt" />
            <zeebe:output source="={state: a2a.state, answer: a2a.answer}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="Fraud_Start" name="Question received">
          <bpmn:outgoing>Fraud_F1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Fraud_Send" name="Send message to fraud agent" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
          <bpmn:documentation>A2A 1.0 Client, operation sendMessage. Returns at once with the task; the answer is polled below.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
            <zeebe:ioMapping>
              <zeebe:input source="=(if is defined(fraudAgentUrl) and fraudAgentUrl != null then fraudAgentUrl else &#34;http://localhost:38090&#34;)" target="baseUrl" />
              <zeebe:input source="sendMessage" target="operationId" />
              <zeebe:input source="a2a" target="rpcPath" />
              <zeebe:input source="=&#34;/&#34;+rpcPath" target="operationPath" />
              <zeebe:input source="=text" target="text" />
              <zeebe:input source="noAuth" target="authType" />
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;, &#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
              <zeebe:input source="={}" target="queryParameters" />
              <zeebe:input source="POST" target="method" />
              <zeebe:input source="=true" target="ignoreNullValues" />
              <zeebe:input source="={jsonrpc: &#34;2.0&#34;, id: string(uuid()), method: &#34;SendMessage&#34;, params: {message: {messageId: string(uuid()), role: &#34;ROLE_USER&#34;, parts: [{text: text}]}, configuration: {returnImmediately: true}}}" target="body" />
              <zeebe:input source="=baseUrl + operationPath" target="url" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={a2a: if response.body.error != null then {state: &#34;ERROR&#34;, answer: response.body.error.message} else if response.body.result.task != null then {taskId: response.body.result.task.id, state: response.body.result.task.status.state, answer: response.body.result.task.status.message.parts[1].text} else if response.body.result.status != null then {taskId: response.body.result.id, state: response.body.result.status.state, answer: response.body.result.status.message.parts[1].text} else {state: &#34;TASK_STATE_COMPLETED&#34;, answer: response.body.result.message.parts[1].text}, attempt: if attempt = null then 1 else attempt + 1}" />
              <zeebe:header key="retryBackoff" value="PT30S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Fraud_F1</bpmn:incoming>
          <bpmn:outgoing>Fraud_F2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="Fraud_Join">
          <bpmn:incoming>Fraud_F2</bpmn:incoming>
          <bpmn:incoming>Fraud_F5</bpmn:incoming>
          <bpmn:outgoing>Fraud_F6</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="Fraud_Settled" name="Answer ready?" default="Fraud_FNo">
          <bpmn:incoming>Fraud_F6</bpmn:incoming>
          <bpmn:outgoing>Fraud_FYes</bpmn:outgoing>
          <bpmn:outgoing>Fraud_FNo</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="Fraud_End" name="Opinion received">
          <bpmn:incoming>Fraud_FYes</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:intermediateCatchEvent id="Fraud_Wait" name="Wait 3 s">
          <bpmn:incoming>Fraud_FNo</bpmn:incoming>
          <bpmn:outgoing>Fraud_F4</bpmn:outgoing>
          <bpmn:timerEventDefinition>
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3S</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:serviceTask id="Fraud_GetTask" name="Get task from fraud agent">
          <bpmn:documentation>A2A 1.0 GetTask on the task that SendMessage returned.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
            <zeebe:ioMapping>
              <zeebe:input source="=(if is defined(fraudAgentUrl) and fraudAgentUrl != null then fraudAgentUrl else &#34;http://localhost:38090&#34;) + &#34;/a2a&#34;" target="url" />
              <zeebe:input source="={jsonrpc: &#34;2.0&#34;, id: string(uuid()), method: &#34;GetTask&#34;, params: {id: a2a.taskId}}" target="body" />
              <zeebe:input source="noAuth" target="authType" />
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;, &#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
              <zeebe:input source="={}" target="queryParameters" />
              <zeebe:input source="POST" target="method" />
              <zeebe:input source="=true" target="ignoreNullValues" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={a2a: if response.body.error != null then {state: &#34;ERROR&#34;, answer: response.body.error.message} else if response.body.result.task != null then {taskId: response.body.result.task.id, state: response.body.result.task.status.state, answer: response.body.result.task.status.message.parts[1].text} else if response.body.result.status != null then {taskId: response.body.result.id, state: response.body.result.status.state, answer: response.body.result.status.message.parts[1].text} else {state: &#34;TASK_STATE_COMPLETED&#34;, answer: response.body.result.message.parts[1].text}, attempt: if attempt = null then 1 else attempt + 1}" />
              <zeebe:header key="retryBackoff" value="PT30S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Fraud_F4</bpmn:incoming>
          <bpmn:outgoing>Fraud_F5</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Fraud_F1" sourceRef="Fraud_Start" targetRef="Fraud_Send" />
        <bpmn:sequenceFlow id="Fraud_F6" sourceRef="Fraud_Join" targetRef="Fraud_Settled" />
        <bpmn:sequenceFlow id="Fraud_F2" sourceRef="Fraud_Send" targetRef="Fraud_Join" />
        <bpmn:sequenceFlow id="Fraud_FYes" name="yes" sourceRef="Fraud_Settled" targetRef="Fraud_End">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(a2a.state != "TASK_STATE_WORKING" and a2a.state != "TASK_STATE_SUBMITTED") or attempt &gt;= 40</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Fraud_FNo" name="no" sourceRef="Fraud_Settled" targetRef="Fraud_Wait" />
        <bpmn:sequenceFlow id="Fraud_F4" sourceRef="Fraud_Wait" targetRef="Fraud_GetTask" />
        <bpmn:sequenceFlow id="Fraud_F5" sourceRef="Fraud_GetTask" targetRef="Fraud_Join" />
      </bpmn:subProcess>
    </bpmn:adHocSubProcess>
    <bpmn:userTask id="ReviewDraftedDecision" name="Review drafted decision">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="ReviewDisputeForm" />
        <zeebe:ioMapping>
          <zeebe:input source="=if agent.responseJson != null then agent.responseJson else if contains(agent.responseText, &#34;```json&#34;) then from json(substring before(substring after(agent.responseText, &#34;```json&#34;), &#34;```&#34;)) else if contains(agent.responseText, &#34;{&#34;) then from json(&#34;{&#34; + substring after(agent.responseText, &#34;{&#34;)) else from json(agent.responseText)" target="draft" />
          <zeebe:input source="=null" target="analystVerdict" />
          <zeebe:input source="=disputeDocuments" target="sourceDocuments" />
          <zeebe:output source="=analystVerdict" target="analystVerdict" />
          <zeebe:output source="=if analystVerdict = &#34;revise&#34; then &#34;The human analyst sent your draft back. Feedback: &#34; + analystFeedback + &#34; Revise the decision and reply with the same JSON format. Reply with only the JSON object from the policy Output section, using exactly the keys decision, refundAmount, reasonCode, policyVersion, rationale and evidence. The decision field must be exactly one of APPROVE, ESCALATE or DENY.&#34; else null" target="followUpInput" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="AnalystAcceptsDraft" name="Analyst accepts draft?" default="Flow_Revise">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_Revise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="DisputeDecided" name="Dispute decided">
      <bpmn:incoming>Flow_Accept</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToAgentInput" sourceRef="DisputeReceived" targetRef="JoinAgentInput" />
    <bpmn:sequenceFlow id="Flow_ToAgent" sourceRef="JoinAgentInput" targetRef="DisputeAgent" />
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="DisputeAgent" targetRef="ReviewDraftedDecision" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="ReviewDraftedDecision" targetRef="AnalystAcceptsDraft" />
    <bpmn:sequenceFlow id="Flow_Accept" name="Yes" sourceRef="AnalystAcceptsDraft" targetRef="DisputeDecided">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=analystVerdict = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Revise" name="No, revise" sourceRef="AnalystAcceptsDraft" targetRef="JoinAgentInput" />
    <bpmn:textAnnotation id="Note_LinkedPolicy">
      <bpmn:text>Governed external instructions (#75), prototype: the agent links the deployed Markdown policy as a system-prompt resource. The engine pins the version at each activation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_LinkedPolicy" sourceRef="DisputeAgent" targetRef="Note_LinkedPolicy" />
    <bpmn:textAnnotation id="Note_Agent">
      <bpmn:text>8.11 prototype: documents flow from the prompt into the sandbox tool (#81); policy linked as a governed system-prompt resource (#75).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Agent" sourceRef="DisputeAgent" targetRef="Note_Agent" />
    <bpmn:textAnnotation id="Note_WebFetch">
      <bpmn:text>8.11 prototype (#83): the agent also has an OpenRouter server tool, openrouter:web_search, limited to mastercard.com. The model provider runs it, not a BPMN task, and returns cited URLs (agent context: openai.citations). Uses the global OpenRouter endpoint. This REST task stays as the authoritative source of the synthetic rules.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Sandbox">
      <bpmn:text>8.11 prototype (#82, #81): the agent imports the attached CSV into a Daytona sandbox (sandbox_import_document) and computes dates with generated Python. Reconcile transactions (#81) reads the export document by name.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_A2A">
      <bpmn:text>8.11 (#113): A2A 1.0 client to the external fraud agent, polled with GetTask.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_WebFetch" sourceRef="FetchCardNetworkRules" targetRef="Note_WebFetch" />
    <bpmn:association id="Assoc_Sandbox" sourceRef="AnalyzeInSandbox" targetRef="Note_Sandbox" />
    <bpmn:association id="Assoc_A2A" sourceRef="AskFraudRiskAgent" targetRef="Note_A2A" />
  </bpmn:process>
