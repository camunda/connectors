{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "A2A 1.0 Client Webhook Intermediate Catch Event",
  "id" : "dev.hansel.a2a.client.webhook.intermediate.v1",
  "description" : "Receives A2A 1.0 push notifications (StreamResponse) for a task sent with the A2A 1.0 Client. Correlates on the task ID; a push without the expected X-A2A-Notification-Token is rejected.",
  "documentationRef" : "https://a2a-protocol.org/latest/specification/",
  "version" : 4,
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [ "bpmn:IntermediateCatchEvent", "bpmn:IntermediateThrowEvent" ],
  "elementType" : {
    "value" : "bpmn:IntermediateCatchEvent",
    "eventDefinition" : "bpmn:MessageEventDefinition"
  },
  "engines" : {
    "camunda" : "^8.10"
  },
  "groups" : [ {
    "id" : "endpoint",
    "label" : "Webhook"
  }, {
    "id" : "correlation",
    "label" : "Correlation"
  }, {
    "id" : "activation",
    "label" : "Activation"
  }, {
    "id" : "output",
    "label" : "Output mapping"
  } ],
  "properties" : [ {
    "value" : "io.camunda:webhook:1",
    "binding" : {
      "name" : "inbound.type",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "inbound.shouldValidateHmac",
    "value" : "disabled",
    "binding" : {
      "name" : "inbound.shouldValidateHmac",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "synchronousResponse",
    "value" : "false",
    "binding" : {
      "name" : "synchronousResponse",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "consumeUnmatchedEvents",
    "value" : "true",
    "binding" : {
      "name" : "consumeUnmatchedEvents",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "deduplicationModeManualFlag",
    "value" : "false",
    "binding" : {
      "name" : "deduplicationModeManualFlag",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "deduplicationMode",
    "value" : "AUTO",
    "binding" : {
      "name" : "deduplicationMode",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "inbound.method",
    "value" : "post",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.method",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "inbound.context",
    "label" : "Webhook ID",
    "description" : "Part of the URL: {connectors base}/inbound/{webhook ID}. Use the same URL as the client's webhook URL.",
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.context",
      "type" : "zeebe:property"
    },
    "type" : "String"
  }, {
    "id" : "inbound.auth.type",
    "value" : "APIKEY",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.auth.type",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "inbound.auth.apiKey",
    "label" : "Notification token",
    "description" : "The token the client sent as push notification token; every push must carry it as X-A2A-Notification-Token.",
    "value" : "{{secrets.A2A_PUSH_TOKEN}}",
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.auth.apiKey",
      "type" : "zeebe:property"
    },
    "type" : "String"
  }, {
    "id" : "inbound.auth.apiKeyLocator",
    "value" : "=request.headers.`x-a2a-notification-token`",
    "group" : "endpoint",
    "binding" : {
      "name" : "inbound.auth.apiKeyLocator",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "correlationKeyProcess",
    "label" : "Task ID",
    "description" : "The ID of the task the A2A 1.0 Client sent: the Task's id for a new task, the Message's taskId for a follow-up.",
    "value" : "=if agentResponse.result.taskId != null then agentResponse.result.taskId else agentResponse.result.id",
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "required",
    "group" : "correlation",
    "binding" : {
      "name" : "correlationKey",
      "type" : "bpmn:Message#zeebe:subscription#property"
    },
    "type" : "String"
  }, {
    "id" : "correlationKeyExpression",
    "value" : "=(if request.body.task != null then request.body.task.id else request.body.statusUpdate.taskId)",
    "group" : "correlation",
    "binding" : {
      "name" : "correlationKeyExpression",
      "type" : "zeebe:property"
    },
    "type" : "Hidden"
  }, {
    "id" : "messageTtl",
    "label" : "Message TTL",
    "description" : "How long a push waits for the event to start waiting. A push can arrive before the send task has returned.",
    "optional" : true,
    "value" : "PT1M",
    "constraints" : {
      "notEmpty" : false,
      "pattern" : {
        "value" : "^(PT.*|)$",
        "message" : "must be an ISO-8601 duration"
      }
    },
    "feel" : "optional",
    "group" : "correlation",
    "binding" : {
      "name" : "messageTtl",
      "type" : "zeebe:property"
    },
    "type" : "String"
  }, {
    "id" : "messageNameUuid",
    "label" : "Message name",
    "generatedValue" : {
      "type" : "uuid"
    },
    "feel" : "optional",
    "group" : "correlation",
    "binding" : {
      "name" : "name",
      "type" : "bpmn:Message#property"
    },
    "tooltip" : "By default, this is an auto-generated random UUID. We recommend using a unique message name for each connector element in the diagram. Override to set a custom message name. Learn more about <a href=\"https://docs.camunda.io/docs/components/concepts/messages/#message-subscriptions\">message subscriptions</a> that power inbound connectors.",
    "type" : "String"
  }, {
    "id" : "activationCondition",
    "label" : "Activation condition",
    "description" : "By default the event fires on final, input-required and auth-required states.",
    "optional" : true,
    "value" : "=list contains([\"TASK_STATE_COMPLETED\", \"TASK_STATE_FAILED\", \"TASK_STATE_CANCELED\", \"TASK_STATE_REJECTED\", \"TASK_STATE_INPUT_REQUIRED\", \"TASK_STATE_AUTH_REQUIRED\"], (if request.body.task != null then request.body.task.status.state else request.body.statusUpdate.status.state))",
    "feel" : "required",
    "group" : "activation",
    "binding" : {
      "name" : "activationCondition",
      "type" : "zeebe:property"
    },
    "type" : "String"
  }, {
    "id" : "resultVariable",
    "label" : "Result variable",
    "description" : "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
    "group" : "output",
    "binding" : {
      "name" : "resultVariable",
      "type" : "zeebe:property"
    },
    "type" : "String"
  }, {
    "id" : "resultExpression",
    "label" : "Result expression",
    "description" : "Maps the push request to process variables. The default hands the pushed Task to the AI agent as toolCallResult.",
    "value" : "={toolCallResult: if request.body.task != null then request.body.task else request.body}",
    "feel" : "required",
    "group" : "output",
    "binding" : {
      "name" : "resultExpression",
      "type" : "zeebe:property"
    },
    "type" : "Text"
  } ],
  "icon" : {
    "contents" : "data:image/svg+xml;base64,"
  }
}
