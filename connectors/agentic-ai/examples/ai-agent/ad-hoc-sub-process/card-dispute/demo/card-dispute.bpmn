<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="CardDisputeDefinitions" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="CardDispute" name="Card dispute" isExecutable="true">
    <bpmn:startEvent id="DisputeReceived" name="Dispute received">
      <bpmn:documentation>Tasklist start form: upload a PDF and paste dispute text. Synthetic example output is copy-paste documentation only. Configured skill references are uploaded at deployment and stored durably. Transactions must be extracted from the uploaded PDF; no CSV is preloaded. CLI variables take precedence.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="StartDisputeForm" bindingType="deployment" />
        <zeebe:ioMapping>
          <zeebe:output source='=if is defined(disputeId) and disputeId != null then disputeId else "DSP-2026-10-0042"' target="disputeId" />
          <zeebe:output source='=if is defined(cardholderName) and cardholderName != null then cardholderName else "Jordan Avery"' target="cardholderName" />
          <zeebe:output source='=if is defined(cardLast4) and cardLast4 != null then cardLast4 else "4417"' target="cardLast4" />
          <zeebe:output source="=if is defined(disputedAmount) and disputedAmount != null then disputedAmount else 482.17" target="disputedAmount" />
          <zeebe:output source='=if is defined(clusterApiUrl) and clusterApiUrl != null then clusterApiUrl else "http://localhost:8280"' target="clusterApiUrl" />
          <zeebe:output source='=if is defined(disputeFilingDate) and disputeFilingDate != null then disputeFilingDate else "2026-10-20"' target="disputeFilingDate" />
          <zeebe:output source='=if is defined(deadlineScriptSha256) and deadlineScriptSha256 != null then deadlineScriptSha256 else "816444bd5c28a64e7ff99c7de4bb6c706e42b3bfe56acc1c98e9089c07fa8416"' target="deadlineScriptSha256" />
          <zeebe:output source='=if is defined(deadlineSkillManifest) and deadlineSkillManifest != null then deadlineSkillManifest else {SKILL.md: "d5578fc9cc2aab966ce67a10578f8efffac546d5b9caecfa9f336b910432a33d", references/network-rules.md: "1c8187d0367d3979954b7902195deb546a1d619507fa96edd1272689bff49171", scripts/deadline.py: "816444bd5c28a64e7ff99c7de4bb6c706e42b3bfe56acc1c98e9089c07fa8416"}' target="deadlineSkillManifest" />
          <zeebe:output source='=if is defined(deadlineSkillBundles) and deadlineSkillBundles != null then deadlineSkillBundles else [{camunda.document.type: "camunda", storeId: "in-memory", documentId: "53735519-edb3-48f8-bcc0-16560f80a18c", contentHash: "bb3c9c71875849369ab5c6c55702c2f342688bbdea0750642e964386aac5eb26", metadata: {contentType: "application/zip", fileName: "chargeback-deadline.zip", expiresAt: null, size: 3901, processDefinitionId: null, processInstanceKey: null, customProperties: {}}}]' target="deadlineSkillBundles" />
          <zeebe:output source='=if is defined(deadlineSkillBundleSha256) and deadlineSkillBundleSha256 != null then deadlineSkillBundleSha256 else "bb3c9c71875849369ab5c6c55702c2f342688bbdea0750642e964386aac5eb26"' target="deadlineSkillBundleSha256" />
          <zeebe:output source='=if is defined(disputeDocuments) and disputeDocuments != null then disputeDocuments else concatenate(statementDocuments, [{camunda.document.type: "camunda", storeId: "in-memory", documentId: "fe46caf6-d5ac-4dee-a4a5-eb13bbf4af56", contentHash: "d5578fc9cc2aab966ce67a10578f8efffac546d5b9caecfa9f336b910432a33d", metadata: {contentType: "text/markdown", fileName: "SKILL.md", expiresAt: null, size: 2563, processDefinitionId: null, processInstanceKey: null, customProperties: {}}}, {camunda.document.type: "camunda", storeId: "in-memory", documentId: "e8ef6348-021e-4850-8465-c7ca960e39f4", contentHash: "1c8187d0367d3979954b7902195deb546a1d619507fa96edd1272689bff49171", metadata: {contentType: "text/markdown", fileName: "network-rules.md", expiresAt: null, size: 2489, processDefinitionId: null, processInstanceKey: null, customProperties: {}}}, {camunda.document.type: "camunda", storeId: "in-memory", documentId: "ebee690c-cc12-4118-a548-4fd9a78fdf92", contentHash: "816444bd5c28a64e7ff99c7de4bb6c706e42b3bfe56acc1c98e9089c07fa8416", metadata: {contentType: "text/x-python", fileName: "deadline.py", expiresAt: null, size: 3520, processDefinitionId: null, processInstanceKey: null, customProperties: {}}}])' target="disputeDocuments" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value='{"claim": "Synthetic demo only. I was charged twice for one headphones order from Northwind Electronics in mid-September. I only placed one order."}' />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_ToAgentInput</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="JoinAgentInput">
      <bpmn:incoming>Flow_ToAgentInput</bpmn:incoming>
      <bpmn:incoming>Flow_Revise</bpmn:incoming>
      <bpmn:outgoing>Flow_ToAgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:adHocSubProcess id="DisputeAgent" name="Dispute agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="101" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="openai" target="provider.type" />
          <zeebe:input source="responses" target="provider.openai.api.type" />
          <zeebe:input source="custom" target="provider.openai.backend.type" />
          <zeebe:input source="=camunda.vars.env.cardDisputeLlm" target="provider.openai.backend.custom.openAiCustomCredential" />
          <zeebe:input source="modelDefault" target="provider.openai.api.responses.effort" />
          <zeebe:input source="={plugins: [{id: &#34;file-parser&#34;, pdf: {engine: &#34;native&#34;}}]}" target="provider.openai.backend.custom.bodyProperties" />
          <zeebe:input source="=(if is defined(followUpInput) and followUpInput != null then followUpInput else &#34;# New card dispute &#34; + disputeId + &#34;\n\n- Cardholder: &#34; + cardholderName + &#34;\n- Card ending: &#34; + cardLast4 + &#34;\n- Disputed amount: &#34; + string(disputedAmount) + &#34;\n\n## Claim\n\n&#34; + claim + &#34;\n\n## Statement extraction\n\n- Read the attached PDF statement using provider-side PDF parsing.\n- No transaction CSV is attached or preloaded.\n- Extract the relevant merchant transaction rows, including all its charges and posted refunds, from that PDF only.\n- Preserve transaction references, transaction dates (not posting dates), original descriptions and signed amounts.\n- Normalize the merchant consistently across charge and refund descriptions, without changing their meaning.\n\n## Transaction CSV\n\n- Request `sandbox_fs_write` to create `/home/daytona/statement-transactions.csv` from those extracted rows, with header `id,date,merchant,amount,description`.\n- Use ISO dates, decimal signed amounts and comma-free cells (replace commas in descriptions with spaces).\n- Do not invent rows or use a fixture.\n\n## Reconciliation\n\n- Request `sandbox_export_document` for that actual path, then pass the returned document tag to `ReconcileTransactions` with the normalized merchant and disputed amount.\n- Use its result for all transaction arithmetic.\n- Cite the source PDF document ID, actual sandbox CSV path and exported document ID in evidence.\n- If extraction is incomplete or ambiguous, report it rather than substituting known demo data.\n\n## Decision\n\nThen draft a decision using the policy JSON keys `decision`, `refundAmount`, `reasonCode`, `rationale` and `evidence`. `decision` must be `APPROVE`, `ESCALATE` or `DENY`.&#34;) + &#34;\n\n## Configured chargeback-deadline skill\n\n- The chargeback-deadline Skills ZIP is configured on the sandbox connector.\n- Configured ZIP reference: `&#34; + string(deadlineSkillBundles[1].documentId) + &#34;`\n- CREATE must return a catalog containing `chargeback-deadline`.\n- Use its materialized files under `&#60;CREATE.workDir&#62;/.agents/skills/chargeback-deadline`.\n- Startup script is empty.\n- Attached skill documents are previews only.\n\n### Read the skill\n\n- Read `SKILL.md` and `references/network-rules.md` with `sandbox_fs_read` before requesting script execution.\n\n### Run the deadline script\n\n- Ask `sandbox_bash` to run `python3 .agents/skills/chargeback-deadline/scripts/deadline.py` from `CREATE.workDir` with:\n  - matched charge dates from `ReconcileTransactions`\n  - the reference reason code\n  - and `--filed-on &#34; + disputeFilingDate + &#34;`\n- The sandbox executes the configured script, not you.\n\n### Restrictions\n\n- Do not import replacement documents, copy, regenerate or modify skill files.\n- Writing the extracted transaction CSV is allowed; modifying the skill is not.\n- Do not request hash-check commands; package byte verification happens outside the agent.\n\n### Evidence\n\n- Include ZIP reference, CREATE catalog entry and actual paths, and the complete returned JSON stdout in an evidence item starting `Chargeback deadline skill:`.\n- Require exit code zero.\n- If extraction, catalog, files or sandbox fail, report missing evidence; do not calculate a fallback deadline.&#34;" target="data.userPrompt.prompt" />
          <zeebe:input source="=disputeDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="content" target="data.userPrompt.documentDelivery" />
          <zeebe:input source="=agent.context" target="agentContext" />
          <zeebe:input source="custom" target="data.memory.storage.type" />
          <zeebe:input source="observation-masking" target="data.memory.storage.storeType" />
          <zeebe:input source="={}" target="data.memory.storage.parameters" />
          <zeebe:input source="=12" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="true" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="instructionSource" value="resource" />
          <zeebe:header key="systemPromptBinding" value="latest" />
          <zeebe:header key="elementTemplateVersion" value="101" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:linkedResources>
          <zeebe:linkedResource resourceId="dispute-compliance-policy.md" resourceType="system-prompt" linkName="systemPrompt" />
        </zeebe:linkedResources>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
      <bpmn:subProcess id="ReconcileTransactions" name="Reconcile transactions (document in)">
        <bpmn:documentation>Reconcile a CSV document extracted from the uploaded PDF in the sandbox. Pass the document returned by sandbox_export_document, not a preloaded fixture. Required columns: id,date,merchant,amount; use transaction dates, signed decimal amounts and consistently normalized merchant names. Returns the matching charges, posted refunds, duplicate confirmation, days between charges, overcharge amount and actual source document. Use this for all arithmetic over transactions.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.exportDocument, &#34;The transaction export document (CSV) to reconcile&#34;, &#34;document&#34;)" target="sourceDocument" />
            <zeebe:input source="=fromAi(toolCall.merchant, &#34;Merchant name exactly as it appears in the export, for example Northwind Electronics&#34;)" target="disputedMerchant" />
            <zeebe:input source="=fromAi(toolCall.amount, &#34;Disputed charge amount&#34;, &#34;number&#34;)" target="disputedAmount" />
            <zeebe:input target="reconcileResult" />
            <zeebe:output source="=reconcileResult" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="Reconcile_Start" name="Tool called">
          <bpmn:outgoing>Reconcile_F1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Reconcile_F1" sourceRef="Reconcile_Start" targetRef="Reconcile_ReadDocument" />
        <bpmn:serviceTask id="Reconcile_ReadDocument" name="Read export document" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
            <zeebe:ioMapping>
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="GET" target="method" />
              <zeebe:input source="=clusterApiUrl + &#34;/v2/documents/&#34; + sourceDocument.documentId + &#34;?storeId=&#34; + sourceDocument.storeId + &#34;&#38;contentHash=&#34; + sourceDocument.contentHash" target="url" />
              <zeebe:input source="=false" target="followRedirects" />
              <zeebe:input source="TEXT" target="documentReturnFormat.choice" />
              <zeebe:input source="UTF-8" target="documentReturnFormat.encoding" />
              <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="=20" target="readTimeoutInSeconds" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="elementTemplateVersion" value="18" />
              <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
              <zeebe:header key="resultExpression" value="={exportCsv: response.body}" />
              <zeebe:header key="retryBackoff" value="PT30S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Reconcile_F1</bpmn:incoming>
          <bpmn:outgoing>Reconcile_F2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:sequenceFlow id="Reconcile_F2" sourceRef="Reconcile_ReadDocument" targetRef="Reconcile_Compute" />
        <bpmn:scriptTask id="Reconcile_Compute" name="Reconcile">
          <bpmn:extensionElements>
            <zeebe:script expression="={lines: split(exportCsv, &#34;\r?\n&#34;)[item != &#34;&#34;], header: split(lines[1], &#34;,&#34;), iId: index of(header, &#34;id&#34;)[1], iDate: index of(header, &#34;date&#34;)[1], iMerchant: index of(header, &#34;merchant&#34;)[1], iAmount: index of(header, &#34;amount&#34;)[1], rows: for line in sublist(lines, 2) return {id: split(line, &#34;,&#34;)[iId], date: split(line, &#34;,&#34;)[iDate], merchant: split(line, &#34;,&#34;)[iMerchant], amount: number(split(line, &#34;,&#34;)[iAmount])}, matches: rows[merchant = disputedMerchant and amount = disputedAmount], matchCount: count(matches), refundsPosted: rows[merchant = disputedMerchant and amount &#60; 0], refundTotal: if count(refundsPosted) = 0 then 0 else -sum(refundsPosted.amount), result: {method: &#34;Read the export document, matched on merchant and amount, then listed refunds already posted for that merchant&#34;, sourceDocumentId: sourceDocument.documentId, sourceDocument: sourceDocument.metadata.fileName, rowsRead: count(rows), matches: matches, matchCount: matchCount, refundsPosted: refundsPosted, refundTotal: refundTotal, duplicateConfirmed: matchCount &#62;= 2, daysBetweenCharges: if matchCount &#62;= 2 then (date(matches[2].date) - date(matches[1].date)).days else null, overchargeAmount: if matchCount &#62;= 2 then disputedAmount * (matchCount - 1) else 0}}.result" resultVariable="reconcileResult" />
          </bpmn:extensionElements>
          <bpmn:incoming>Reconcile_F2</bpmn:incoming>
          <bpmn:outgoing>Reconcile_F3</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:sequenceFlow id="Reconcile_F3" sourceRef="Reconcile_Compute" targetRef="Reconcile_End" />
        <bpmn:endEvent id="Reconcile_End" name="Reconciled">
          <bpmn:incoming>Reconcile_F3</bpmn:incoming>
        </bpmn:endEvent>
      </bpmn:subProcess>
      <bpmn:serviceTask id="AnalyzeInSandbox" name="Analyze in sandbox (Daytona)" zeebe:modelerTemplate="io.camunda.connectors.agenticai.sandbox.daytona.v0" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>CREATE materializes the configured Skills ZIP. The agent reads SKILL.md and its reference under CREATE.workDir/.agents/skills/chargeback-deadline, then requests a sandbox tool call to run the configured deadline.py and return its results. The sandbox executes the code. Package byte verification stays outside the agent. Do not import replacements, calculate dates with the model, or use fallback code.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping source="">
            <zeebe:input source="=null" target="toolCallResult" />
            <zeebe:input source="=if is defined(daytonaApiUrl) and daytonaApiUrl != null then (if is defined(daytonaApiKey) and daytonaApiKey != null then daytonaApiKey else &#34;mock-daytona-key&#34;) else &#34;{{secrets.DAYTONA_API_KEY}}&#34;" target="data.apiKey" />
            <zeebe:input source="=if is defined(daytonaApiUrl) and daytonaApiUrl != null then daytonaApiUrl else null" target="data.apiUrl" />
            <zeebe:input source="DURATION" target="data.autoStop.mode" />
            <zeebe:input source="PT5M" target="data.autoStop.duration" />
            <zeebe:input source="DEFAULT" target="data.autoArchive.mode" />
            <zeebe:input source="IMMEDIATELY" target="data.autoDelete.mode" />
            <zeebe:input source="=deadlineSkillBundles" target="data.skills" />
            <zeebe:input source="=fromAi(toolCall.startupScript, &#34;Optional shell script run once at sandbox creation (e.g. to install tools or add skills). Runs after skill bundles are materialized.&#34;, &#34;string&#34;)" target="data.startupScript" />
            <zeebe:input source="aiAgentTool" target="data.connectorMode.type" />
            <zeebe:input source="=toolCall" target="data.connectorMode.toolCall" />
            <zeebe:output source="=toolCallResult" target="toolCallResult" />
          </zeebe:ioMapping>
          <zeebe:taskDefinition type="io.camunda.agenticai:sandboxdaytona:1" retries="1" />
          <zeebe:taskHeaders source="">
            <zeebe:header key="elementTemplateVersion" value="1" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.sandbox.daytona.v0" />
            <zeebe:header key="resultVariable" value="toolCallResult" />
            <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;SANDBOX_UNAVAILABLE&#34;, error.message, {sandboxError: error.message, toolCallResult: null}) else null" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
          <zeebe:properties>
            <zeebe:property name="io.camunda.agenticai.gateway.type" value="sandbox" />
          </zeebe:properties>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:subProcess id="AskFraudRiskAgent" name="Ask fraud risk agent">
        <bpmn:documentation>Ask the bank's external fraud risk agent for a risk opinion on this dispute, over A2A. Returns the agent's answer as text. Call this once per dispute. It waits until the agent pushes its answer, up to 2 minutes.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.question, &#34;What you want the fraud agent to assess, including merchant, amount, dates, transaction references, and the cardholder claim&#34;)" target="text" />
            <zeebe:input source="=null" target="a2a" />
            <zeebe:input source="=null" target="pushed" />
            <zeebe:output source="=if pushed != null then {taskId: a2a.taskId, state: pushed.state, answer: pushed.answer, remoteProcessInstanceKey: a2a.remoteProcessInstanceKey, remoteOperateUrl: a2a.remoteOperateUrl, evidence: {kind: &#34;a2a&#34;, agentUrl: (if is defined(fraudAgentUrl) and fraudAgentUrl != null then fraudAgentUrl else &#34;http://localhost:38090&#34;) + &#34;/a2a&#34;, authScheme: &#34;bearer&#34;, delivery: &#34;push&#34;, remoteProcessInstanceKey: a2a.remoteProcessInstanceKey, remoteOperateUrl: a2a.remoteOperateUrl}} else {taskId: a2a.taskId, state: &#34;TIMEOUT&#34;, answer: &#34;The fraud agent did not answer within 2 minutes.&#34;, remoteProcessInstanceKey: a2a.remoteProcessInstanceKey, remoteOperateUrl: a2a.remoteOperateUrl, evidence: {kind: &#34;a2a&#34;, agentUrl: (if is defined(fraudAgentUrl) and fraudAgentUrl != null then fraudAgentUrl else &#34;http://localhost:38090&#34;) + &#34;/a2a&#34;, authScheme: &#34;bearer&#34;, delivery: &#34;push&#34;, remoteProcessInstanceKey: a2a.remoteProcessInstanceKey, remoteOperateUrl: a2a.remoteOperateUrl}}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="Fraud_Start" name="Question received">
          <bpmn:outgoing>Fraud_F1</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:serviceTask id="Fraud_Send" name="Send message to fraud agent" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
          <bpmn:documentation>A2A 1.0 Client, operation sendMessage. Returns at once with the task. The remote agent pushes the answer to the webhook below.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
            <zeebe:ioMapping>
              <zeebe:input source="=(if is defined(fraudAgentUrl) and fraudAgentUrl != null then fraudAgentUrl else &#34;http://localhost:38090&#34;)" target="baseUrl" />
              <zeebe:input source="sendMessage" target="operationId" />
              <zeebe:input source="a2a" target="rpcPath" />
              <zeebe:input source="=&#34;/&#34;+rpcPath" target="operationPath" />
              <zeebe:input source="=text" target="text" />
              <zeebe:input source="=(if is defined(fraudPushUrl) and fraudPushUrl != null then fraudPushUrl else &#34;http://host.docker.internal:8286/inbound/a2a-fraud-agent-reply&#34;)" target="webhookUrl" />
              <zeebe:input source="{{secrets.A2A_PUSH_TOKEN}}" target="pushToken" />
              <zeebe:input source="bearer" target="authType" />
              <zeebe:input source="bearer" target="authentication.type" />
              <zeebe:input source="{{secrets.FRAUD_AGENT_TOKEN}}" target="authentication.token" />
              <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;, &#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
              <zeebe:input source="={}" target="queryParameters" />
              <zeebe:input source="POST" target="method" />
              <zeebe:input source="=true" target="ignoreNullValues" />
              <zeebe:input source="={jsonrpc: &#34;2.0&#34;, id: string(uuid()), method: &#34;SendMessage&#34;, params: {message: {messageId: string(uuid()), role: &#34;ROLE_USER&#34;, parts: [{text: text}]}, configuration: {returnImmediately: true, taskPushNotificationConfig: {url: webhookUrl, token: pushToken}}}}" target="body" />
              <zeebe:input source="=baseUrl + operationPath" target="url" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={a2a: if response.body.error != null then {state: &#34;ERROR&#34;, answer: response.body.error.message} else if response.body.result.task != null then {taskId: response.body.result.task.id, state: response.body.result.task.status.state, answer: response.body.result.task.status.message.parts[1].text, remoteProcessInstanceKey: response.body.result.task.metadata.camunda.processInstanceKey, remoteOperateUrl: response.body.result.task.metadata.camunda.operateUrl} else if response.body.result.status != null then {taskId: response.body.result.id, state: response.body.result.status.state, answer: response.body.result.status.message.parts[1].text, remoteProcessInstanceKey: response.body.result.metadata.camunda.processInstanceKey, remoteOperateUrl: response.body.result.metadata.camunda.operateUrl} else {state: &#34;TASK_STATE_COMPLETED&#34;, answer: response.body.result.message.parts[1].text}}" />
              <zeebe:header key="retryBackoff" value="PT30S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Fraud_F1</bpmn:incoming>
          <bpmn:outgoing>Fraud_F2</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:eventBasedGateway id="Fraud_Race" name="Answer or timeout">
          <bpmn:incoming>Fraud_F2</bpmn:incoming>
          <bpmn:outgoing>Fraud_F3</bpmn:outgoing>
          <bpmn:outgoing>Fraud_F4</bpmn:outgoing>
        </bpmn:eventBasedGateway>
        <bpmn:intermediateCatchEvent id="Fraud_Answer" name="Fraud agent answered" zeebe:modelerTemplate="dev.hansel.a2a.client.webhook.intermediate.v1" zeebe:modelerTemplateVersion="4">
          <bpmn:documentation>A2A 1.0 Client Webhook. Receives the fraud agent push notification. It checks X-A2A-Notification-Token against the push token and correlates on the task ID that sendMessage returned.</bpmn:documentation>
          <bpmn:extensionElements>
            <zeebe:properties>
              <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
              <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
              <zeebe:property name="synchronousResponse" value="false" />
              <zeebe:property name="consumeUnmatchedEvents" value="true" />
              <zeebe:property name="deduplicationModeManualFlag" value="false" />
              <zeebe:property name="deduplicationMode" value="AUTO" />
              <zeebe:property name="inbound.method" value="post" />
              <zeebe:property name="inbound.context" value="a2a-fraud-agent-reply" />
              <zeebe:property name="inbound.auth.type" value="APIKEY" />
              <zeebe:property name="inbound.auth.apiKey" value="{{secrets.A2A_PUSH_TOKEN}}" />
              <zeebe:property name="inbound.auth.apiKeyLocator" value="=request.headers.`x-a2a-notification-token`" />
              <zeebe:property name="correlationKeyExpression" value="=(if request.body.task != null then request.body.task.id else if request.body.id != null then request.body.id else request.body.statusUpdate.taskId)" />
              <zeebe:property name="messageTtl" value="PT1M" />
              <zeebe:property name="activationCondition" value="=list contains([&#34;TASK_STATE_COMPLETED&#34;, &#34;TASK_STATE_FAILED&#34;, &#34;TASK_STATE_CANCELED&#34;, &#34;TASK_STATE_REJECTED&#34;, &#34;TASK_STATE_INPUT_REQUIRED&#34;, &#34;TASK_STATE_AUTH_REQUIRED&#34;], (if request.body.task != null then request.body.task.status.state else if request.body.status != null then request.body.status.state else request.body.statusUpdate.status.state))" />
              <zeebe:property name="resultVariable" value="" />
              <zeebe:property name="resultExpression" value="={pushed: {taskId: (if request.body.task != null then request.body.task else request.body).id, state: (if request.body.task != null then request.body.task else request.body).status.state, answer: (if request.body.task != null then request.body.task else request.body).status.message.parts[1].text}}" />
            </zeebe:properties>
          </bpmn:extensionElements>
          <bpmn:incoming>Fraud_F3</bpmn:incoming>
          <bpmn:outgoing>Fraud_F5</bpmn:outgoing>
          <bpmn:messageEventDefinition id="Fraud_AnswerDef" messageRef="Message_FraudAgentReply" />
        </bpmn:intermediateCatchEvent>
        <bpmn:intermediateCatchEvent id="Fraud_Timeout" name="No answer in 2 min">
          <bpmn:incoming>Fraud_F4</bpmn:incoming>
          <bpmn:outgoing>Fraud_F6</bpmn:outgoing>
          <bpmn:timerEventDefinition id="Fraud_TimeoutDef">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="Fraud_End" name="Opinion received">
          <bpmn:incoming>Fraud_F5</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:endEvent id="Fraud_TimeoutEnd" name="No opinion">
          <bpmn:incoming>Fraud_F6</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Fraud_F1" sourceRef="Fraud_Start" targetRef="Fraud_Send" />
        <bpmn:sequenceFlow id="Fraud_F2" sourceRef="Fraud_Send" targetRef="Fraud_Race" />
        <bpmn:sequenceFlow id="Fraud_F3" sourceRef="Fraud_Race" targetRef="Fraud_Answer" />
        <bpmn:sequenceFlow id="Fraud_F4" sourceRef="Fraud_Race" targetRef="Fraud_Timeout" />
        <bpmn:sequenceFlow id="Fraud_F5" sourceRef="Fraud_Answer" targetRef="Fraud_End" />
        <bpmn:sequenceFlow id="Fraud_F6" sourceRef="Fraud_Timeout" targetRef="Fraud_TimeoutEnd" />
      </bpmn:subProcess>
      <bpmn:boundaryEvent id="Sandbox_Error" name="Sandbox unavailable" attachedToRef="AnalyzeInSandbox">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:output source="={error: &#34;SANDBOX_FAILED&#34;, message: &#34;The sandbox call failed. The filing deadline is not computed.&#34;}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:errorEventDefinition id="Sandbox_ErrorDef" errorRef="Error_SandboxUnavailable" />
      </bpmn:boundaryEvent>
    </bpmn:adHocSubProcess>
    <bpmn:userTask id="ReviewDraftedDecision" name="Review drafted decision">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="ReviewDisputeForm" />
        <zeebe:ioMapping>
          <zeebe:input source="=if agent.responseJson != null then agent.responseJson else if contains(agent.responseText, &#34;```json&#34;) then from json(substring before(substring after(agent.responseText, &#34;```json&#34;), &#34;```&#34;)) else if contains(agent.responseText, &#34;{&#34;) then from json(&#34;{&#34; + substring after(agent.responseText, &#34;{&#34;)) else from json(agent.responseText)" target="draft" />
          <zeebe:input source="=null" target="analystVerdict" />
          <zeebe:input source="=(if agent.responseDocuments != null then concatenate(disputeDocuments, for e in get entries(agent.responseDocuments) return e.value.document) else disputeDocuments)[item != null]" target="sourceDocuments" />
          <zeebe:output source="=analystVerdict" target="analystVerdict" />
          <zeebe:output source="=if analystVerdict = &#34;revise&#34; then &#34;## Analyst feedback\n\nThe human analyst sent your draft back.\n\nFeedback: &#34; + analystFeedback + &#34;\n\n## Revision\n\n- Revise the decision and reply with the same JSON format.\n- Reply with only the JSON object from the policy Output section, using exactly the keys `decision`, `refundAmount`, `reasonCode`, `rationale` and `evidence`.\n- The `decision` field must be exactly one of `APPROVE`, `ESCALATE` or `DENY`.&#34; else null" target="followUpInput" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="AnalystAcceptsDraft" name="Analyst accepts draft?" default="Flow_Revise">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Accept</bpmn:outgoing>
      <bpmn:outgoing>Flow_Revise</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="DisputeDecided" name="Dispute decided">
      <bpmn:incoming>Flow_Accept</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToAgentInput" sourceRef="DisputeReceived" targetRef="JoinAgentInput" />
    <bpmn:sequenceFlow id="Flow_ToAgent" sourceRef="JoinAgentInput" targetRef="DisputeAgent" />
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="DisputeAgent" targetRef="ReviewDraftedDecision" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="ReviewDraftedDecision" targetRef="AnalystAcceptsDraft" />
    <bpmn:sequenceFlow id="Flow_Accept" name="Yes" sourceRef="AnalystAcceptsDraft" targetRef="DisputeDecided">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=analystVerdict = "accept"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Revise" name="No, revise" sourceRef="AnalystAcceptsDraft" targetRef="JoinAgentInput" />
    <bpmn:textAnnotation id="Note_LinkedPolicy">
      <bpmn:text>#75 governed prompt: linked policy, latest version resolved and recorded per run</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_LinkedPolicy" sourceRef="DisputeAgent" targetRef="Note_LinkedPolicy" />
    <bpmn:textAnnotation id="Note_Agent">
      <bpmn:text>#81 documents in, passed to tools by doc tag;
#83 statement PDF parsed by file-parser (native)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_Agent" sourceRef="DisputeAgent" targetRef="Note_Agent" />
    <bpmn:textAnnotation id="Note_Sandbox">
      <bpmn:text>#82 configured Skills ZIP: read its instructions and rules, then run its materialized deadline.py unchanged in Daytona</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_A2A">
      <bpmn:text>#113 A2A 1.0 fraud agent with bearer auth, 2m timeout and webhook response</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0o8q9mh">
      <bpmn:text>Custom observation masking compaction (https://arxiv.org/pdf/2508.21433)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_110gv7o" associationDirection="None" sourceRef="DisputeAgent" targetRef="TextAnnotation_0o8q9mh" />
    <bpmn:association id="Assoc_Sandbox" sourceRef="AnalyzeInSandbox" targetRef="Note_Sandbox" />
    <bpmn:association id="Assoc_A2A" sourceRef="AskFraudRiskAgent" targetRef="Note_A2A" />
  </bpmn:process>
  <bpmn:error id="Error_SandboxUnavailable" name="Sandbox unavailable" errorCode="SANDBOX_UNAVAILABLE" />
  <bpmn:message id="Message_FraudAgentReply" name="FraudAgentReply" zeebe:modelerTemplate="dev.hansel.a2a.client.webhook.intermediate.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=a2a.taskId" />
    </bpmn:extensionElements>
