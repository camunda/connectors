{
  "$schema" : "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name" : "A2A 1.0 Client",
  "id" : "dev.hansel.a2a.client.v1",
  "description" : "Agent-to-Agent (A2A) 1.0 client over JSON-RPC: read a remote agent's Agent Card or send it a message. Runs on the HTTP JSON connector.",
  "documentationRef" : "https://a2a-protocol.org/latest/specification/",
  "version" : 1,
  "category" : {
    "id" : "connectors",
    "name" : "Connectors"
  },
  "appliesTo" : [ "bpmn:Task" ],
  "elementType" : {
    "value" : "bpmn:ServiceTask"
  },
  "engines" : {
    "camunda" : "^8.10"
  },
  "groups" : [ {
    "id" : "server",
    "label" : "Server"
  }, {
    "id" : "authentication",
    "label" : "Authentication"
  }, {
    "id" : "operation",
    "label" : "Operation"
  }, {
    "id" : "parameters",
    "label" : "Parameters"
  }, {
    "id" : "requestBody",
    "label" : "Request body"
  }, {
    "id" : "url",
    "label" : "URL"
  }, {
    "id" : "output",
    "label" : "Output mapping"
  }, {
    "id" : "error",
    "label" : "Error handling"
  }, {
    "id" : "retries",
    "label" : "Retries"
  } ],
  "properties" : [ {
    "value" : "io.camunda:http-json:1",
    "binding" : {
      "property" : "type",
      "type" : "zeebe:taskDefinition"
    },
    "type" : "Hidden"
  }, {
    "id" : "baseUrl",
    "label" : "Base URL",
    "value" : "",
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "server",
    "binding" : {
      "name" : "baseUrl",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "authType",
    "value" : "noAuth",
    "group" : "authentication",
    "binding" : {
      "name" : "authType",
      "type" : "zeebe:input"
    },
    "type" : "Hidden"
  }, {
    "id" : "noAuth",
    "value" : "noAuth",
    "group" : "authentication",
    "binding" : {
      "name" : "authentication.type",
      "type" : "zeebe:input"
    },
    "type" : "Hidden"
  }, {
    "id" : "operationId",
    "value" : "fetchAgentCard",
    "group" : "operation",
    "binding" : {
      "name" : "operationId",
      "type" : "zeebe:input"
    },
    "type" : "Dropdown",
    "choices" : [ {
      "name" : "Fetch Agent Card",
      "value" : "fetchAgentCard"
    }, {
      "name" : "Send message",
      "value" : "sendMessage"
    } ]
  }, {
    "id" : "fetchAgentCard_path_agentCardLocation",
    "label" : "Agent card location",
    "description" : "Path of the Agent Card relative to the base URL.",
    "optional" : false,
    "value" : ".well-known/agent-card.json",
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "parameters",
    "binding" : {
      "name" : "agentCardLocation",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "fetchAgentCard",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "fetchAgentCard_$path",
    "value" : "=\"/\"+agentCardLocation",
    "group" : "parameters",
    "binding" : {
      "name" : "operationPath",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "fetchAgentCard",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "fetchAgentCard_$headers",
    "value" : "={\"A2A-Version\": \"1.0\"}",
    "group" : "parameters",
    "binding" : {
      "name" : "headers",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "fetchAgentCard",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "fetchAgentCard_$queryParameters",
    "value" : "={}",
    "group" : "parameters",
    "binding" : {
      "name" : "queryParameters",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "fetchAgentCard",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "fetchAgentCard_$method",
    "value" : "GET",
    "group" : "parameters",
    "binding" : {
      "name" : "method",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "fetchAgentCard",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "sendMessage_path_rpcPath",
    "label" : "Rpc path",
    "description" : "Path of the JSON-RPC interface relative to the base URL. Ignored when the JSON-RPC URL is set.",
    "optional" : true,
    "value" : "a2a",
    "feel" : "optional",
    "group" : "parameters",
    "binding" : {
      "name" : "rpcPath",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "sendMessage_$path",
    "value" : "=\"/\"+rpcPath",
    "group" : "parameters",
    "binding" : {
      "name" : "operationPath",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "sendMessage_$headers",
    "value" : "={\"A2A-Version\": \"1.0\", \"Content-Type\": \"application/json\"}",
    "group" : "parameters",
    "binding" : {
      "name" : "headers",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "sendMessage_$queryParameters",
    "value" : "={}",
    "group" : "parameters",
    "binding" : {
      "name" : "queryParameters",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "sendMessage_$method",
    "value" : "POST",
    "group" : "parameters",
    "binding" : {
      "name" : "method",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "sendMessage_body_text",
    "label" : "Text",
    "description" : "The text of the message. Use fromAi() when this task is an AI agent tool.",
    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "requestBody",
    "binding" : {
      "name" : "text",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "sendMessage_body_taskId",
    "label" : "Task id",
    "description" : "Set it to continue an existing task, for example one in TASK_STATE_INPUT_REQUIRED.",
    "optional" : true,
    "feel" : "optional",
    "group" : "requestBody",
    "binding" : {
      "name" : "taskId",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "sendMessage_body_contextId",
    "label" : "Context id",
    "description" : "Groups related tasks. The server assigns one when it is empty.",
    "optional" : true,
    "feel" : "optional",
    "group" : "requestBody",
    "binding" : {
      "name" : "contextId",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "sendMessage_body_webhookUrl",
    "label" : "Webhook url",
    "description" : "Where the remote agent pushes task updates. Pair it with an A2A 1.0 Client Webhook event. Leave it empty to read the result from the response only.",
    "optional" : true,
    "feel" : "optional",
    "group" : "requestBody",
    "binding" : {
      "name" : "webhookUrl",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "sendMessage_body_pushToken",
    "label" : "Push token",
    "description" : "Sent with every push as X-A2A-Notification-Token.",
    "optional" : true,
    "value" : "{{secrets.A2A_PUSH_TOKEN}}",
    "feel" : "optional",
    "group" : "requestBody",
    "binding" : {
      "name" : "pushToken",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "sendMessage_$body",
    "value" : "={jsonrpc: \"2.0\", id: string(uuid()), method: \"SendMessage\", params: { message: {messageId: string(uuid()), role: \"ROLE_USER\", parts: [{text: text}], taskId: taskId, contextId: contextId}, configuration: { returnImmediately: webhookUrl != null, taskPushNotificationConfig: if webhookUrl != null then {url: webhookUrl, token: pushToken} else null}}}",
    "group" : "requestBody",
    "binding" : {
      "name" : "body",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "Hidden"
  }, {
    "id" : "resultVariable",
    "label" : "Result variable",
    "description" : "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
    "group" : "output",
    "binding" : {
      "key" : "resultVariable",
      "type" : "zeebe:taskHeader"
    },
    "type" : "String"
  }, {
    "id" : "resultExpression",
    "label" : "Result expression",
    "description" : "result is the Agent Card, the Task or the Message; error is the JSON-RPC error.",
    "value" : "={agentResponse: { result: if response.body.result.task != null then response.body.result.task else if response.body.result.message != null then response.body.result.message else if response.body.result = null and response.body.error = null then response.body else null, error: response.body.error}}",
    "feel" : "required",
    "group" : "output",
    "binding" : {
      "key" : "resultExpression",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Text"
  }, {
    "id" : "errorExpression",
    "label" : "Error expression",
    "description" : "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
    "feel" : "required",
    "group" : "error",
    "binding" : {
      "key" : "errorExpression",
      "type" : "zeebe:taskHeader"
    },
    "type" : "Text"
  }, {
    "id" : "retryCount",
    "label" : "Retries",
    "description" : "Number of retries",
    "value" : "3",
    "feel" : "optional",
    "group" : "retries",
    "binding" : {
      "property" : "retries",
      "type" : "zeebe:taskDefinition"
    },
    "type" : "String"
  }, {
    "id" : "retryBackoff",
    "label" : "Retry backoff",
    "description" : "ISO-8601 duration to wait between retries",
    "value" : "PT30S",
    "group" : "retries",
    "binding" : {
      "key" : "retryBackoff",
      "type" : "zeebe:taskHeader"
    },
    "type" : "String"
  }, {
    "id" : "jobTimeout",
    "label" : "Job timeout",
    "description" : "ISO-8601 duration after which Zeebe considers this job timed out if not yet completed. Leave empty to use the default timeout",
    "optional" : true,
    "group" : "retries",
    "binding" : {
      "key" : "jobTimeout",
      "type" : "zeebe:taskHeader"
    },
    "type" : "String"
  }, {
    "id" : "rpcUrl",
    "label" : "JSON-RPC URL",
    "description" : "The JSONRPC interface URL from the Agent Card's supportedInterfaces. Overrides base URL and path.",
    "optional" : true,
    "feel" : "optional",
    "group" : "operation",
    "binding" : {
      "name" : "rpcUrl",
      "type" : "zeebe:input"
    },
    "condition" : {
      "property" : "operationId",
      "equals" : "sendMessage",
      "type" : "simple"
    },
    "type" : "String"
  }, {
    "id" : "ignoreNullValues",
    "value" : "=true",
    "binding" : {
      "name" : "ignoreNullValues",
      "type" : "zeebe:input"
    },
    "type" : "Hidden"
  }, {
    "id" : "url",
    "value" : "=if operationId = \"sendMessage\" and rpcUrl != null then rpcUrl else baseUrl + operationPath",
    "group" : "url",
    "binding" : {
      "name" : "url",
      "type" : "zeebe:input"
    },
    "type" : "Hidden"
  } ],
  "icon" : {
    "contents" : "data:image/svg+xml;base64,"
  }
}
