<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_documents" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="ai-agent-chat-with-documents" name="AI Agent Chat With Documents" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Request received">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="ai-agent-chat-with-documents-initial-request" />
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;http://localhost:8081&#34;" target="baseUrl" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_start" sourceRef="StartEvent_1" targetRef="Gateway_Join" />
    <bpmn:exclusiveGateway id="Gateway_Join">
      <bpmn:incoming>Flow_start</bpmn:incoming>
      <bpmn:incoming>Flow_followUp</bpmn:incoming>
      <bpmn:outgoing>Flow_toAgent</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_toAgent" sourceRef="Gateway_Join" targetRef="AI_Agent" />
    <bpmn:adHocSubProcess id="AI_Agent" name="AI Agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="anthropic" target="provider.type" />
          <zeebe:input source="anthropic-api" target="provider.anthropic.backend.type" />
          <zeebe:input source="{{secrets.ANTHROPIC_API_KEY}}" target="provider.anthropic.backend.anthropic.apiKey" />
          <zeebe:input source="claude-sonnet-5" target="provider.anthropic.model.model" />
          <zeebe:input source="modelDefault" target="provider.anthropic.model.parameters.effort" />
          <zeebe:input source="modelDefault" target="provider.anthropic.model.parameters.thinking.mode" />
          <zeebe:input source="=true" target="provider.anthropic.model.parameters.promptCaching.enabled" />
          <zeebe:input source="=&#34;You are a helpful agent that can answer questions and work with files. Use the available tools when they help; do not assume tools that are not listed.&#10;&#10;Documents are referenced by id. A document appears as a &lt;doc/&gt; tag with the attributes id, fileName and contentType. When a tool parameter takes a document, pass the id from such a tag.&#10;&#10;Tools:&#10;- Download_File downloads a file from a URL and returns it as a document. The file server is at &#34; + baseUrl + &#34; (for example /image/png, /image/jpeg, /bytes/100).&#10;- Upload_File uploads one document with a description.&#10;- Upload_Many uploads several documents at once.&#10;- Slow_Tool waits until a person completes it.&#10;- Ping answers pong.&#10;- return_document hands one document back to the user as part of your final answer. Call it once per document with a short key and the document the user should receive.&#10;&#10;If a tool reports an unknown document id, choose one of the listed ids and try again.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput)) then followUpInput else inputText" target="data.userPrompt.prompt" />
          <zeebe:input source="=if (is defined(followUpInput) or is defined(followUpDocuments)) then followUpDocuments else inputDocuments" target="data.userPrompt.documents" />
          <zeebe:input source="=agent.context" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:input source="=true" target="data.response.includeDocuments" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_toFeedback</bpmn:outgoing>
      <bpmn:serviceTask id="Download_File" name="Download file" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Downloads a file from a URL and stores it as a document. Returns the HTTP status and the downloaded document.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="GET" target="method" />
            <zeebe:input source="=fromAi(toolCall.url, &#34;The URL of the file to download&#34;)" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="DOCUMENT" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="18" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: {&#10;    status: response.status,&#10;    document: response.document&#10;  }&#10;}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Upload_File" name="Upload file" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Uploads one known document to the file server together with a description.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=baseUrl + &#34;/post&#34;" target="url" />
            <zeebe:input source="={&#34;Content-Type&#34;: &#34;multipart/form-data&#34;}" target="headers" />
            <zeebe:input source="={&#10;  file: fromAi(toolCall.document, &#34;The document to upload&#34;, &#34;document&#34;),&#10;  description: fromAi(toolCall.description, &#34;A short description of the file&#34;)&#10;}" target="body" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="18" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: {&#10;    status: response.status,&#10;    form: response.body.form,&#10;    receivedFiles: for e in get entries(response.body.files) return {field: e.key, parts: count(e.value)}&#10;  }&#10;}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Upload_Many" name="Upload many files" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="18" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Uploads several known documents to the file server in one request.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=baseUrl + &#34;/post&#34;" target="url" />
            <zeebe:input source="={&#34;Content-Type&#34;: &#34;multipart/form-data&#34;}" target="headers" />
            <zeebe:input source="={&#10;  files: fromAi(toolCall.documents, &#34;The documents to upload&#34;, &#34;array&#34;, {&#34;items&#34;: {&#34;type&#34;: &#34;document&#34;}}),&#10;  description: fromAi(toolCall.description, &#34;A short description of the files&#34;)&#10;}" target="body" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="18" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  toolCallResult: {&#10;    status: response.status,&#10;    form: response.body.form,&#10;    receivedFiles: for e in get entries(response.body.files) return {field: e.key, parts: count(e.value)}&#10;  }&#10;}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:userTask id="Slow_Tool" name="Slow tool">
        <bpmn:documentation>A tool that keeps running until a person completes its task.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="ai-agent-chat-with-documents-slow-tool" />
          <zeebe:ioMapping>
            <zeebe:output source="=&#34;Slow tool completed&#34;" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:scriptTask id="Ping" name="Ping">
        <bpmn:documentation>Answers pong. Use it to check that tools work.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=&#34;pong&#34;" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
    <bpmn:sequenceFlow id="Flow_toFeedback" sourceRef="AI_Agent" targetRef="User_Feedback" />
    <bpmn:userTask id="User_Feedback" name="User Feedback">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="ai-agent-chat-with-documents-user-feedback" />
        <zeebe:ioMapping>
          <zeebe:input source="=agent.responseText" target="responseText" />
          <zeebe:input source="=if agent.responseDocuments != null then get entries(agent.responseDocuments).value.document else []" target="returnedDocuments" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_toFeedback</bpmn:incoming>
      <bpmn:outgoing>Flow_feedbackDone</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_feedbackDone" sourceRef="User_Feedback" targetRef="Gateway_Satisfied" />
    <bpmn:exclusiveGateway id="Gateway_Satisfied" name="User satisfied?">
      <bpmn:incoming>Flow_feedbackDone</bpmn:incoming>
      <bpmn:outgoing>Flow_followUp</bpmn:outgoing>
      <bpmn:outgoing>Flow_satisfied</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_followUp" name="no - we follow up" sourceRef="Gateway_Satisfied" targetRef="Gateway_Join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=userSatisfied = null or userSatisfied = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_satisfied" name="yes" sourceRef="Gateway_Satisfied" targetRef="EndEvent_1">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=userSatisfied</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="EndEvent_1" name="Chat finished">
      <bpmn:incoming>Flow_satisfied</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ai-agent-chat-with-documents">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="152" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join" isMarkerVisible="true">
        <dc:Bounds x="245" y="255" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AI_Agent_di" bpmnElement="AI_Agent" isExpanded="true">
        <dc:Bounds x="350" y="130" width="560" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Download_File_di" bpmnElement="Download_File">
        <dc:Bounds x="380" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Upload_File_di" bpmnElement="Upload_File">
        <dc:Bounds x="520" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Upload_Many_di" bpmnElement="Upload_Many">
        <dc:Bounds x="660" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Slow_Tool_di" bpmnElement="Slow_Tool">
        <dc:Bounds x="380" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ping_di" bpmnElement="Ping">
        <dc:Bounds x="520" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="User_Feedback_di" bpmnElement="User_Feedback">
        <dc:Bounds x="980" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Satisfied_di" bpmnElement="Gateway_Satisfied" isMarkerVisible="true">
        <dc:Bounds x="1135" y="255" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1120" y="312" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1252" y="262" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_di" bpmnElement="Flow_start">
        <di:waypoint x="188" y="280" />
        <di:waypoint x="245" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toAgent_di" bpmnElement="Flow_toAgent">
        <di:waypoint x="295" y="280" />
        <di:waypoint x="350" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_toFeedback_di" bpmnElement="Flow_toFeedback">
        <di:waypoint x="910" y="280" />
        <di:waypoint x="980" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_feedbackDone_di" bpmnElement="Flow_feedbackDone">
        <di:waypoint x="1080" y="280" />
        <di:waypoint x="1135" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_followUp_di" bpmnElement="Flow_followUp">
        <di:waypoint x="1160" y="305" />
        <di:waypoint x="1160" y="480" />
        <di:waypoint x="270" y="480" />
        <di:waypoint x="270" y="305" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="670" y="462" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_satisfied_di" bpmnElement="Flow_satisfied">
        <di:waypoint x="1185" y="280" />
        <di:waypoint x="1252" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1210" y="262" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
