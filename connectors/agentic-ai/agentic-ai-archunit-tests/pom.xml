<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda.connector.agenticai</groupId>
    <artifactId>connector-agentic-ai-parent</artifactId>
    <version>8.11.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>agentic-ai-archunit-tests</artifactId>
  <name>agentic-ai-archunit-tests</name>
  <description>Architecture tests for the Agentic AI modules</description>
  <inceptionYear>2026</inceptionYear>
  <packaging>jar</packaging>

  <licenses>
    <license>
      <name>Camunda Self-Managed Free Edition license</name>
      <url>
        https://camunda.com/legal/terms/cloud-terms-and-conditions/camunda-cloud-self-managed-free-edition-terms/
      </url>
    </license>
    <license>
      <name>Camunda Self-Managed Enterprise Edition license</name>
    </license>
  </licenses>

  <dependencies>
    <!-- The production classes of every Agentic AI module, analyzed by the architecture rules -->
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>agentic-ai-common</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-model</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-api</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-provider-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-azure-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-aws-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-provider-openai</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-provider-mistral</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-provider-anthropic</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-provider-gemini</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-provider-bedrock</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-provider-langchain4j</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-memory-agentcore</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-core</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-tools-schema</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-ad-hoc-tools-schema</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-mcp</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-mcp-integration</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-a2a</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-a2a-integration</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-aiagent</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit</artifactId>
      <version>${version.archunit}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-api</artifactId>
      <version>${version.archunit}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5-engine</artifactId>
      <version>${version.archunit}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze-dependencies</id>
            <configuration>
              <ignoredUnusedDeclaredDependencies combine.children="append">
                <!-- analyzed through the class path by the architecture rules, never referenced from test code -->
                <dependency>io.camunda.connector.agenticai:agentic-ai-common</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-model</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-api</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-provider-support</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-core</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-memory-agentcore</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-provider-langchain4j</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-provider-bedrock</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-provider-gemini</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-provider-anthropic</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-test-support</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-provider-mistral</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-provider-openai</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-aws-support</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-azure-support</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-tools-schema</dependency>
                <dependency>io.camunda.connector.agenticai:connector-ad-hoc-tools-schema</dependency>
                <dependency>io.camunda.connector.agenticai:connector-mcp</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-mcp-integration</dependency>
                <dependency>io.camunda.connector.agenticai:connector-a2a</dependency>
                <dependency>io.camunda.connector.agenticai:aiagent-a2a-integration</dependency>
                <dependency>io.camunda.connector.agenticai:connector-aiagent</dependency>
                <dependency>com.tngtech.archunit:archunit-junit5-engine</dependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
