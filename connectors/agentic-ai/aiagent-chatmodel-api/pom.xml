<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda.connector.agenticai</groupId>
    <artifactId>connector-agentic-ai-parent</artifactId>
    <version>8.11.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>aiagent-chatmodel-api</artifactId>
  <name>aiagent-chatmodel-api</name>
  <description>Chat model provider SPI of the Camunda AI Agent</description>
  <inceptionYear>2025</inceptionYear>
  <packaging>jar</packaging>

  <licenses>
    <license>
      <name>Camunda Self-Managed Free Edition license</name>
      <url>
        https://camunda.com/legal/terms/cloud-terms-and-conditions/camunda-cloud-self-managed-free-edition-terms/
      </url>
    </license>
    <license>
      <name>Camunda Self-Managed Enterprise Edition license</name>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-model</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-spring-and-http-client</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <message>The chat model SPI is used by extensions and must not depend on Spring or the HTTP client.</message>
                  <excludes>
                    <exclude>org.springframework:*:*:*:compile</exclude>
                    <exclude>org.springframework:*:*:*:runtime</exclude>
                    <exclude>org.springframework.boot:*:*:*:compile</exclude>
                    <exclude>org.springframework.boot:*:*:*:runtime</exclude>
                    <exclude>io.camunda.connector:http-client:*:*:compile</exclude>
                    <exclude>io.camunda.connector:http-client:*:*:runtime</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.revapi</groupId>
        <artifactId>revapi-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
