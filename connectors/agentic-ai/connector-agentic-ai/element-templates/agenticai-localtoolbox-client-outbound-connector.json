    "optional" : false,
    "constraints" : {
      "notEmpty" : true
    },
    "feel" : "optional",
    "group" : "toolbox",
    "binding" : {
      "name" : "data.containerElementId",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
    "id" : "data.meta",
    "label" : "Meta",
    "description" : "Deterministic (non-LLM) variables forwarded unmodified to the toolbox process instance alongside the tool call, bypassing the LLM entirely.",
    "optional" : true,
    "feel" : "required",
    "group" : "toolbox",
    "binding" : {
      "name" : "data.meta",
      "type" : "zeebe:input"
    },
    "type" : "String"
  }, {
