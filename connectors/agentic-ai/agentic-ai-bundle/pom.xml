<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda.connector.agenticai</groupId>
    <artifactId>connector-agentic-ai-parent</artifactId>
    <version>8.11.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>agentic-ai-bundle</artifactId>
  <name>agentic-ai-bundle</name>
  <description>All agentic AI connectors with their AI Agent gateway tool integrations</description>
  <inceptionYear>2026</inceptionYear>
  <!-- pom packaging: the bundle holds no code, only the dependencies. Depend on it with <type>pom</type>. -->
  <packaging>pom</packaging>

  <licenses>
    <license>
      <name>Camunda Self-Managed Free Edition license</name>
      <url>
        https://camunda.com/legal/terms/cloud-terms-and-conditions/camunda-cloud-self-managed-free-edition-terms/
      </url>
    </license>
    <license>
      <name>Camunda Self-Managed Enterprise Edition license</name>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-aiagent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-ad-hoc-tools-schema</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-mcp-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-a2a</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-a2a-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-otel</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
