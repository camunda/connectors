  "configurationTemplates": [
    {
      "id": "io.camunda.connectors:twilio-authentication:1",
      "kind": "CREDENTIAL",
      "version": 1,
      "name": "Twilio Authentication",
      "properties": [
        {
          "id": "authentication.type",
          "value": "basic",
          "group": "authentication",
          "binding": {
            "name": "authentication.type",
            "type": "property"
          },
          "type": "Hidden"
        },
        {
          "id": "twilioAuthType",
          "label": "Authentication",
          "value": "accountSidAuthToken",
          "choices": [
            {
              "name": "Account SID and auth token",
              "value": "accountSidAuthToken"
            },
            {
              "name": "API key and secret",
              "value": "apiKeySecret"
            }
          ],
          "constraints": {
            "notEmpty": true
          },
          "group": "authentication",
          "binding": {
            "name": "parameters.authType",
            "type": "property"
          },
          "type": "Dropdown"
        },
        {
          "id": "accountSid",
          "label": "Account SID",
          "constraints": {
            "notEmpty": true
          },
          "group": "authentication",
          "binding": {
            "name": "parameters.accountSid",
            "type": "property"
          },
          "type": "String"
        },
        {
          "id": "baseUrl",
          "value": "https://api.twilio.com/2010-04-01/Accounts/${accountSid}",
          "group": "authentication",
          "binding": {
            "name": "baseUrl",
            "type": "property"
          },
          "type": "Hidden"
        },
        {
          "id": "authentication.usernameKey",
          "label": "API key SID",
          "constraints": {
            "notEmpty": true
          },
          "condition": {
            "property": "twilioAuthType",
            "equals": "apiKeySecret",
            "type": "simple"
          },
          "group": "authentication",
          "binding": {
            "name": "authentication.username",
            "type": "property"
          },
          "type": "String"
        },
        {
          "id": "authentication.usernameSid",
          "value": "${accountSid}",
          "condition": {
            "property": "twilioAuthType",
            "equals": "accountSidAuthToken",
            "type": "simple"
          },
          "group": "authentication",
          "binding": {
            "name": "authentication.username",
            "type": "property"
          },
          "type": "Hidden"
        },
        {
          "id": "authentication.passwordKey",
          "label": "API key secret",
          "constraints": {
            "notEmpty": true
          },
          "condition": {
            "property": "twilioAuthType",
            "equals": "apiKeySecret",
            "type": "simple"
          },
          "group": "authentication",
          "binding": {
            "name": "authentication.password",
            "type": "property"
          },
          "type": "String",
          "secret": true
        },
        {
          "id": "authentication.passwordSid",
          "label": "Auth token",
