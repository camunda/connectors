  "documentationRef": "https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "operation",
      "label": "Operation"
    },
    {
      "id": "authentication",
      "label": "Authentication"
    },
    {
      "id": "input",
      "label": "Input"
    },
    {
      "id": "filter",
      "label": "Filter"
    },
    {
      "id": "connector",
      "label": "Connector"
    },
    {
      "id": "output",
      "label": "Response mapping"
    },
    {
      "id": "errors",
      "label": "Error handling"
    },
    {
      "id": "retries",
      "label": "Retries"
    }
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "io.camunda:http-json:1",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "type"
      }
    },
    {
      "label": "Operation type",
      "id": "operationType",
      "group": "operation",
      "type": "Dropdown",
      "optional": false,
      "choices": [
        {
          "name": "Send a SMS",
          "value": "sendSms"
        },
        {
          "name": "Send a WhatsApp message",
          "value": "sendWhatsApp"
        },
        {
          "name": "Get message",
          "value": "getMessage"
        },
        {
          "name": "List messages",
          "value": "listMessages"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "operationType"
      }
    },
    {
      "label": "WhatsApp message type",
      "id": "whatsappMessageType",
      "group": "operation",
      "type": "Dropdown",
      "optional": false,
      "choices": [
        {
          "name": "Free form message",
          "value": "whatsappFreeFormMessage"
        },
        {
          "name": "Template message",
          "value": "whatsappTemplateMessage"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "whatsappMessageType"
      },
      "condition": {
        "property": "operationType",
        "equals": "sendWhatsApp"
      }
    },
    {
      "id": "serviceAuthenticationConfiguration",
      "label": "Authentication credential",
      "tooltip": "Choose a reusable Twilio credential, or configure the one-time authentication below.",
      "optional": true,
      "group": "authentication",
      "binding": {
        "name": "serviceAuthenticationConfiguration",
        "type": "zeebe:input"
      },
      "type": "Configuration",
      "configurationTemplate": "io.camunda.connectors:twilio-authentication:1"
    },
    {
      "id": "authType",
      "label": "Authentication type",
      "group": "authentication",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Account SID and Auth token",
          "value": "accountSidAuthToken"
        },
        {
          "name": "API key and secret",
          "value": "apiKeySecret"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "authType"
      },
      "condition": {
        "property": "serviceAuthenticationConfiguration",
        "isEmpty": true,
        "type": "simple"
      }
    },
    {
      "label": "Account SID",
      "tooltip": "Your Twilio account SID. See <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound\" target=\"_blank\">Twilio outbound connector documentation</a>",
      "group": "authentication",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "accountSid"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "authType",
            "oneOf": [
              "apiKeySecret",
              "accountSidAuthToken"
            ]
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": true,
            "type": "simple"
          }
        ]
      }
    },
    {
      "value": "basic",
      "type": "Hidden",
      "binding": {
        "type": "zeebe:input",
        "name": "authentication.type"
      },
      "condition": {
        "property": "serviceAuthenticationConfiguration",
        "isEmpty": true,
        "type": "simple"
      }
    },
    {
      "type": "Hidden",
      "value": "post",
      "binding": {
        "type": "zeebe:input",
        "name": "method"
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "sendSms",
          "sendWhatsApp"
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "get",
      "binding": {
        "type": "zeebe:input",
        "name": "method"
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages",
          "getMessage"
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "={\"Content-Type\":\"application/x-www-form-urlencoded\"}",
      "binding": {
        "type": "zeebe:input",
        "name": "headers"
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "sendSms",
          "sendWhatsApp"
        ]
      },
      "optional": false
    },
    {
      "label": "API key",
      "tooltip": "Your Twilio API key. See <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound\" target=\"_blank\">Twilio outbound connector documentation</a>",
      "group": "authentication",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "authentication.username"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "authType",
            "equals": "apiKeySecret"
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": true,
            "type": "simple"
          }
        ]
      }
    },
    {
      "label": "API secret",
      "tooltip": "Your Twilio API secret. See <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound\" target=\"_blank\">Twilio outbound connector documentation</a>",
      "group": "authentication",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "authentication.password"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "authType",
            "equals": "apiKeySecret"
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": true,
            "type": "simple"
          }
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "=accountSid",
      "binding": {
        "type": "zeebe:input",
        "name": "authentication.username"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "authType",
            "oneOf": [
              "accountSidAuthToken"
            ]
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": true,
            "type": "simple"
          }
        ]
      }
    },
    {
      "label": "Authentication token",
      "tooltip": "Your Twilio auth token. See <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound\" target=\"_blank\">Twilio outbound connector documentation</a>",
      "group": "authentication",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "authentication.password"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "authType",
            "equals": "accountSidAuthToken"
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": true,
            "type": "simple"
          }
        ]
      }
    },
    {
      "label": "Message SID",
      "tooltip": "Unique identifier of the message to retrieve information for.",
      "group": "input",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "messageSid"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "getMessage"
        ]
      },
      "optional": false
    },
    {
      "label": "WhatsApp message text",
      "tooltip": "The content of the WhatsApp message that will be sent.",
      "group": "input",
      "type": "Text",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "WhatsAppBody"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "equals": "sendWhatsApp"
          },
          {
            "property": "whatsappMessageType",
            "equals": "whatsappFreeFormMessage"
          }
        ]
      },
      "optional": false
    },
    {
      "label": "WhatsApp template ID",
      "group": "input",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "ContentSid"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "equals": "sendWhatsApp"
          },
          {
            "property": "whatsappMessageType",
            "equals": "whatsappTemplateMessage"
          }
        ]
      },
      "optional": false
    },
    {
      "label": "WhatsApp template parameters",
      "tooltip": "Parameter values to substitute in the template provided as a FEEL context with numbered keys; make sure all keys and values are strings or are converted to strings!",
      "group": "input",
      "type": "Text",
      "feel": "required",
      "value": "{\n  \"1\": \"Test\",\n  \"2\": \"Message\"\n  // Add more parameters as needed\n}",
      "binding": {
        "type": "zeebe:input",
        "name": "ContentVariables"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "equals": "sendWhatsApp"
          },
          {
            "property": "whatsappMessageType",
            "equals": "whatsappTemplateMessage"
          }
        ]
      },
      "optional": false
    },
    {
      "label": "From WhatsApp number",
      "tooltip": "The originating Twilio WhatsApp phone number used for sending the message.",
      "placeholder": "whatsapp:+1234567890",
      "group": "input",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "From"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationType",
        "equals": "sendWhatsApp"
      },
      "optional": false
    },
    {
      "label": "To WhatsApp number",
      "tooltip": "The recipient's WhatsApp phone number.",
      "placeholder": "whatsapp:+1234567890",
      "group": "input",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "To"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationType",
        "equals": "sendWhatsApp"
      },
      "optional": false
    },
    {
      "type": "Hidden",
      "value": "={\"ContentVariables\": to json(ContentVariables), \"ContentSid\": ContentSid, \"From\": From, \"To\": To}",
      "binding": {
        "type": "zeebe:input",
        "name": "body"
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "equals": "sendWhatsApp"
          },
          {
            "property": "whatsappMessageType",
            "equals": "whatsappTemplateMessage"
          }
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "={\"Body\": WhatsAppBody, \"From\": From, \"To\": To}",
      "binding": {
        "type": "zeebe:input",
        "name": "body"
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "equals": "sendWhatsApp"
          },
          {
            "property": "whatsappMessageType",
            "equals": "whatsappFreeFormMessage"
          }
        ]
      }
    },
    {
      "label": "Message text",
      "tooltip": "The content of the message that will be sent.",
      "group": "input",
      "type": "Text",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "body.Body"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationType",
        "equals": "sendSms"
      },
      "optional": false
    },
    {
      "label": "From number",
      "tooltip": "The originating Twilio phone number used for sending the message.",
      "group": "input",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "body.From"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationType",
        "equals": "sendSms"
      },
      "optional": false
    },
    {
      "label": "To number",
      "tooltip": "The recipient's phone number.",
      "group": "input",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "body.To"
      },
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "operationType",
        "equals": "sendSms"
      },
      "optional": false
    },
    {
      "label": "Page size",
      "id": "pageSize",
      "tooltip": "The maximum number of messages to retrieve per page.",
      "group": "filter",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "pageSizeValue"
      },
      "constraints": {
        "notEmpty": false
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages"
        ]
      },
      "optional": true
    },
    {
      "label": "Date sent",
      "tooltip": "The date and time the message was sent (<a href=\"https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound\" target=\"_blank\">in UTC format</a>)",
      "group": "filter",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "dateSentValue"
      },
      "constraints": {
        "notEmpty": false
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages"
        ]
      },
      "optional": true
    },
    {
      "label": "Date before message was sent",
      "tooltip": "The date and time before which messages were sent (<a href=\"https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound\" target=\"_blank\">in UTC format</a>)",
      "group": "filter",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "dateSentBeforeValue"
      },
      "constraints": {
        "notEmpty": false
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages"
        ]
      },
      "optional": true
    },
    {
      "label": "Date after message was sent",
      "tooltip": "The date and time after which messages were sent (<a href=\"https://docs.camunda.io/docs/8.10/components/connectors/out-of-the-box-connectors/twilio/?twilio=outbound\" target=\"_blank\">in UTC format</a>)",
      "group": "filter",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "dateSentAfterValue"
      },
      "constraints": {
        "notEmpty": false
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages"
        ]
      },
      "optional": true
    },
    {
      "label": "From",
      "tooltip": "The phone number or client identifier of the message sender.",
      "group": "filter",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "fromFilterValue"
      },
      "constraints": {
        "notEmpty": false
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages"
        ]
      },
      "optional": true
    },
    {
      "label": "To",
      "tooltip": "The phone number or client identifier of the message recipient.",
      "group": "filter",
      "type": "String",
      "feel": "optional",
      "binding": {
        "type": "zeebe:input",
        "name": "toFilterValue"
      },
      "constraints": {
        "notEmpty": false
      },
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages"
        ]
      },
      "optional": true
    },
    {
      "type": "Hidden",
      "value": "=put all(if(dateSentValue = null) then {} else {\"DateSent\":dateSentValue} , if(dateSentAfterValue = null) then {} else {\"DateSent>\":dateSentAfterValue} ,  if(dateSentBeforeValue = null) then {} else {\"DateSent<\":dateSentBeforeValue} , if(fromFilterValue = null) then {} else {\"From\":fromFilterValue}, if(toFilterValue = null) then {} else {\"To\":toFilterValue}, if(pageSizeValue = null) then {} else {\"PageSize\":pageSizeValue})",
      "binding": {
        "type": "zeebe:input",
        "name": "queryParameters"
      },
      "optional": true,
      "condition": {
        "property": "operationType",
        "oneOf": [
          "listMessages"
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "=\"https://api.twilio.com/2010-04-01/Accounts/\"+accountSid+\"/Messages.json\"",
      "binding": {
        "type": "zeebe:input",
        "name": "url"
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "oneOf": [
              "sendSms",
              "sendWhatsApp",
              "listMessages"
            ]
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": true,
            "type": "simple"
          }
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "=\"/Messages.json\"",
      "binding": {
        "type": "zeebe:input",
        "name": "relativeUrl"
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "oneOf": [
              "sendSms",
              "sendWhatsApp",
              "listMessages"
            ]
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": false,
            "type": "simple"
          }
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "=\"https://api.twilio.com/2010-04-01/Accounts/\"+accountSid+\"/Messages/\"+messageSid+\".json\"",
      "binding": {
        "type": "zeebe:input",
        "name": "url"
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "oneOf": [
              "getMessage"
            ]
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": true,
            "type": "simple"
          }
        ]
      }
    },
    {
      "type": "Hidden",
      "value": "=\"/Messages/\"+messageSid+\".json\"",
      "binding": {
        "type": "zeebe:input",
        "name": "relativeUrl"
      },
      "condition": {
        "allMatch": [
          {
            "property": "operationType",
            "oneOf": [
              "getMessage"
            ]
          },
          {
            "property": "serviceAuthenticationConfiguration",
            "isEmpty": false,
            "type": "simple"
          }
        ]
      }
    },
    {
      "label": "Result variable",
      "tooltip": "Name of variable to store the response in. <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/use-connectors/#result-variable\" target=\"_blank\">result variable documentation</a>",
      "group": "output",
      "type": "String",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultVariable"
      }
    },
    {
      "label": "Result expression",
      "tooltip": "Expression to map the response into process variables. <a href=\"https://docs.camunda.io/docs/8.10/components/connectors/use-connectors/#result-expression\" target=\"_blank\">result expression documentation</a>",
      "group": "output",
      "type": "Text",
      "feel": "required",
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "resultExpression"
      }
    },
    {
