{
  "name": "connectors (Linux / native Docker Engine)",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": false
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },

  "remoteUser": "vscode",

  "mounts": [
    "source=${localEnv:SSH_AUTH_SOCK},target=/ssh-agent,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=connectors-maven-cache,target=/home/vscode/.m2,type=volume",
    "source=connectors-npm-cache,target=/home/vscode/.npm,type=volume"
  ],

  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  },

  "containerEnv": {
    "TESTCONTAINERS_HOST_OVERRIDE": "host.docker.internal"
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "sudo chmod 666 /ssh-agent"
}
