<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda.connector</groupId>
    <artifactId>connector-sdk-parent</artifactId>
    <relativePath>../pom.xml</relativePath>
    <version>8.10.0-SNAPSHOT</version>
  </parent>

  <name>Connector SDK Test</name>
  <description>Camunda Connector Test</description>
  <artifactId>connector-test</artifactId>
  <packaging>jar</packaging>
  <url>https://github.com/camunda/connectors</url>
  <scm>
    <url>https://github.com/camunda/connectors</url>
    <connection>scm:git:git@github.com:camunda/connectors.git</connection>
    <developerConnection>scm:git:git@github.com:camunda/connectors.git</developerConnection>
    <tag>HEAD</tag>
  </scm>
  <developers>
    <developer>
      <id>camunda</id>
      <name>Camunda</name>
      <email>info@camunda.com</email>
      <url>https://camunda.com</url>
      <organization>Camunda Services GmbH</organization>
      <organizationUrl>https://camunda.com</organizationUrl>
    </developer>
  </developers>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>



  <dependencies>
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze-dependencies</id>
            <configuration>
              <ignoredDependencies>
                <!-- false positives: these dependencies are used in the test library -->
                <ignoredDependency>org.mockito:mockito-core</ignoredDependency>
                <ignoredDependency>org.assertj:assertj-core</ignoredDependency>
              </ignoredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>