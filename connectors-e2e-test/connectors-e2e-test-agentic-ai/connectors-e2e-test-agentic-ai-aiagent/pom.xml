<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.camunda.connector</groupId>
    <artifactId>connectors-e2e-test-agentic-ai</artifactId>
    <relativePath>../pom.xml</relativePath>
    <version>8.11.0-SNAPSHOT</version>
  </parent>

  <description>AI Agent E2E Tests</description>
  <name>Connectors E2e Test Agentic Ai AI Agent</name>
  <artifactId>connectors-e2e-test-agentic-ai-aiagent</artifactId>
  <packaging>jar</packaging>

  <profiles>
    <profile>
      <id>it-real-llm</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${plugin.version.maven-surefire-plugin}</version>
            <configuration>
              <includes>
                <include>**/*E2ETestIT.java</include>
                <include>**/DocumentToolCallResultsIT.java</include>
              </includes>
              <systemPropertyVariables>
                <!-- Surfaces the connectors container log; scoped to this suite by pointing at a
                     file logback does not pick up on its own. -->
                <logback.configurationFile>${project.basedir}/src/test/resources/logback-real-llm.xml</logback.configurationFile>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <!-- The AI Agent tests also cover the ad-hoc tools schema connector and the MCP and A2A gateway
       tools, so they need every agentic AI connector and integration. -->
  <dependencies>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-aiagent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-ad-hoc-tools-schema</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-mcp</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-mcp-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>connector-a2a</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector.agenticai</groupId>
      <artifactId>aiagent-a2a-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-http-json</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connectors-e2e-test-agentic-ai-base</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>uk.org.webcompere</groupId>
      <artifactId>system-stubs-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
