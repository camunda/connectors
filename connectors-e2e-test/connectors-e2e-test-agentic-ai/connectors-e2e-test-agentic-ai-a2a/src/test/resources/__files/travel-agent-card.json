{
  "name": "Travel agent",
  "description": "Helps with travel bookings",
  "version": "1.0.0",
  "documentationUrl": "http://example.com/docs",
  "capabilities": {
    "streaming": true,
    "pushNotifications": true,
    "extendedAgentCard": false
  },
  "defaultInputModes": [
    "text"
  ],
  "defaultOutputModes": [
    "text"
  ],
  "skills": [
    {
      "id": "hotel-booking",
      "name": "Hotel Booking",
      "description": "Book a hotel room",
      "tags": [
        "booking",
        "hotel"
      ],
      "examples": [
        "Book a single room",
        "Book a double room"
      ]
    }
  ],
  "supportedInterfaces": [
    {
      "protocolBinding": "JSONRPC",
      "url": "%s/travel-agent",
      "protocolVersion": "1.0"
    }
  ]
}
